# Servidor ScreenFlow (1.4.1) como serviço do systemd. O install-server.sh instala este arquivo em
# /etc/systemd/system/. A configuração (nome, senha, porta) fica em /etc/screenflow-servidor.env, legível só pelo root.
[Unit]
Description=Servidor ScreenFlow (tela, chat e voz para todo mundo)
Documentation=https://github.com/KaykyFerro/SCREENFLOW-REMOTE/blob/main/docs/SERVIDOR.md
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
ExecStart=/opt/screenflow-servidor/screenflow-servidor
EnvironmentFile=-/etc/screenflow-servidor.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# Usuário próprio, criado pelo systemd, sem acesso ao resto do PC. O chat, os canais e o log ficam em
# /var/lib/screenflow-servidor (a variável STATE_DIRECTORY diz onde).
DynamicUser=yes
StateDirectory=screenflow-servidor
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=65536
# O .NET compila código na hora (precisa de memória que escreve e executa): MemoryDenyWriteExecute fica desligado.
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

[Install]
WantedBy=multi-user.target
