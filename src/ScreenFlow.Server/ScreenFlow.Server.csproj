<Project Sdk="Microsoft.NET.Sdk">
  <!-- O programa do servidor ScreenFlow (1.4.1): roda no Linux e no Windows, sem janela. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>screenflow-servidor</AssemblyName>
    <RootNamespace>ScreenFlow.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Sem os .pdb do Core na publicação (o executável já leva os símbolos dele). -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <!-- Publicação de um arquivo só, com o .NET junto (o PC servidor não precisa instalar nada). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenFlow.Core\ScreenFlow.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- No Linux, o instalador do serviço vai junto (sudo ./install-server.sh). -->
    <None Include="..\..\deploy\linux\*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
  </ItemGroup>
</Project>
