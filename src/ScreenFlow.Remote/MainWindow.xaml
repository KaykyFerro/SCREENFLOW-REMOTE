<Window x:Class="ScreenFlow.Remote.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ScreenFlow Remote" Width="1000" Height="700" MinWidth="850" MinHeight="600" Background="#0B0F14" Foreground="#F3F6F9"><Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#18212B"/><Setter Property="Foreground" Value="#F3F6F9"/><Setter Property="BorderBrush" Value="#263443"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/></Style></Window.Resources><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,20"><StackPanel><TextBlock FontSize="28" FontWeight="Bold">ScreenFlow <Run Foreground="#43E08B">Remote</Run></TextBlock><TextBlock Foreground="#9AA8B5" Margin="0,4,0,0">Compartilhamento remoto de tela</TextBlock></StackPanel><TextBlock DockPanel.Dock="Right" Text="FASE 1 · FOUNDATION" Foreground="#43E08B" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Border Background="#111820" CornerRadius="14" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12">Displays detectados</TextBlock><ComboBox x:Name="MonitorCombo" Background="#18212B" Foreground="#F3F6F9" Padding="8" SelectionChanged="MonitorCombo_SelectionChanged"/><TextBlock x:Name="MonitorDetails" Foreground="#9AA8B5" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Content="Atualizar monitores" Click="RefreshMonitors_Click" Margin="0,20,0,0"/><TextBlock Foreground="#9AA8B5" Margin="0,18,0,0" TextWrapping="Wrap">A detecção usa informações do Windows. Captura de vídeo ainda será adicionada na próxima fase.</TextBlock></StackPanel></Border><Border Grid.Column="1" Background="#111820" CornerRadius="14" Padding="24" Margin="12,0,0,0"><StackPanel><TextBlock FontSize="20" FontWeight="SemiBold">Estado do projeto</TextBlock><TextBlock Foreground="#43E08B" FontSize="16" Margin="0,16,0,6">Fundação em desenvolvimento</TextBlock><TextBlock Foreground="#9AA8B5" TextWrapping="Wrap">A aplicação está detectando displays locais. As etapas seguintes adicionam captura, pipeline de vídeo, transporte e sessões.</TextBlock><Separator Margin="0,20,0,20" Background="#263443"/><TextBlock FontSize="16" FontWeight="SemiBold">Roadmap</TextBlock><TextBlock Margin="0,12,0,0">● Estrutura de solução e dashboard</TextBlock><TextBlock Foreground="#43E08B">● Detecção de monitores</TextBlock><TextBlock Foreground="#9AA8B5" Margin="0,8,0,0">○ Windows Graphics Capture</TextBlock><TextBlock Foreground="#9AA8B5" Margin="0,8,0,0">○ Encoding por hardware</TextBlock><TextBlock Foreground="#9AA8B5" Margin="0,8,0,0">○ WebRTC / P2P</TextBlock><TextBlock Foreground="#9AA8B5" Margin="0,8,0,0">○ Adaptador de qualidade</TextBlock><TextBlock Foreground="#9AA8B5" Margin="0,8,0,0">○ Áudio e controle remoto autorizado</TextBlock></StackPanel></Border></Grid><DockPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Foreground="#9AA8B5" Text="ScreenFlow Remote · Windows 10/11" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Recarregar diagnóstico" Click="RefreshMonitors_Click"/></DockPanel></Grid></Window>