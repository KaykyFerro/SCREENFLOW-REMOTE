<Window x:Class="ScreenFlow.Remote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenFlow Remote" Width="1180" Height="820" MinWidth="980" MinHeight="700"
        Background="#0B0F14" Foreground="#F3F6F9" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111820"/>
        <SolidColorBrush x:Key="Surface" Color="#18212B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#263443"/>
        <SolidColorBrush x:Key="Accent" Color="#43E08B"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA8B5"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#18212B"/>
            <Setter Property="Foreground" Value="#F3F6F9"/>
            <Setter Property="BorderBrush" Value="#263443"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B0F14"/>
            <Setter Property="Foreground" Value="#F3F6F9"/>
            <Setter Property="BorderBrush" Value="#263443"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,5,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#18212B"/>
            <Setter Property="Foreground" Value="#F3F6F9"/>
            <Setter Property="BorderBrush" Value="#263443"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,22">
            <StackPanel>
                <TextBlock FontSize="29" FontWeight="Bold">ScreenFlow <Run Foreground="#43E08B">Remote</Run></TextBlock>
                <TextBlock Foreground="#9AA8B5" Margin="0,4,0,0">Compartilhamento de tela entre computadores</TextBlock>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#14251D" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="LAN MVP · CRIPTOGRAFADO" Foreground="#43E08B" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#111820" CornerRadius="13" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold">Compartilhar minha tela</TextBlock>
                            <TextBlock Foreground="#9AA8B5" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap">Crie uma sessão e autorize cada computador antes de transmitir.</TextBlock>

                            <TextBlock Foreground="#9AA8B5" FontSize="12">Monitor de origem</TextBlock>
                            <ComboBox x:Name="MonitorCombo" DisplayMemberPath="DisplayLabel" SelectionChanged="MonitorCombo_SelectionChanged"/>

                            <TextBlock Foreground="#9AA8B5" FontSize="12">Limite de largura</TextBlock>
                            <ComboBox x:Name="ResolutionCombo">
                                <ComboBoxItem Content="1280" IsSelected="True"/>
                                <ComboBoxItem Content="1600"/>
                                <ComboBoxItem Content="1920"/>
                            </ComboBox>

                            <TextBlock Foreground="#9AA8B5" FontSize="12">FPS alvo do MVP</TextBlock>
                            <ComboBox x:Name="FpsCombo">
                                <ComboBoxItem Content="15"/>
                                <ComboBoxItem Content="20" IsSelected="True"/>
                                <ComboBoxItem Content="30"/>
                            </ComboBox>

                            <Button x:Name="StartHostButton" Content="INICIAR COMPARTILHAMENTO" Background="#43E08B" Foreground="#07120C" BorderBrush="#43E08B" FontWeight="Bold" Click="StartHostButton_Click"/>
                            <Button x:Name="StopHostButton" Content="Encerrar compartilhamento" IsEnabled="False" Click="StopHostButton_Click"/>

                            <Separator Background="#263443" Margin="0,17,0,13"/>
                            <TextBlock Foreground="#9AA8B5" FontSize="11">CÓDIGO DA SESSÃO</TextBlock>
                            <TextBlock x:Name="SessionCodeText" FontSize="17" FontWeight="Bold" Foreground="#43E08B" Text="Nenhuma sessão ativa" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <Button Content="Copiar código" Click="CopyCodeButton_Click"/>
                            <TextBlock Foreground="#9AA8B5" FontSize="11" Margin="0,10,0,3">ENDEREÇO IP DESTA MÁQUINA</TextBlock>
                            <TextBlock x:Name="AddressesText" Foreground="#F3F6F9" TextWrapping="Wrap" FontSize="12" Text="Aguardando criação da sessão"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#111820" CornerRadius="13" Padding="18">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold">Conectar a outro computador</TextBlock>
                            <TextBlock Foreground="#9AA8B5" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap">Digite o IPv4 e o código exibidos pelo transmissor. No MVP, os dois computadores precisam estar na mesma rede local.</TextBlock>
                            <TextBlock Foreground="#9AA8B5" FontSize="12">IP do transmissor</TextBlock>
                            <TextBox x:Name="HostIpBox" Text="192.168.0.100"/>
                            <TextBlock Foreground="#9AA8B5" FontSize="12">Código da sessão</TextBlock>
                            <TextBox x:Name="SessionCodeBox" CharacterCasing="Upper" MaxLength="32"/>
                            <Button x:Name="ConnectButton" Content="CONECTAR" Background="#43E08B" Foreground="#07120C" BorderBrush="#43E08B" FontWeight="Bold" Click="ConnectButton_Click"/>
                            <Button x:Name="DisconnectButton" Content="Desconectar" IsEnabled="False" Click="DisconnectButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="#111820" CornerRadius="13" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,12">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Visualizador remoto"/>
                        <TextBlock x:Name="ViewerResolutionText" DockPanel.Dock="Right" Foreground="#9AA8B5" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#080B0F" CornerRadius="8" BorderBrush="#263443" BorderThickness="1">
                        <Grid>
                            <Image x:Name="RemoteImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
                            <StackPanel x:Name="ViewerPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="SCREENFLOW" FontSize="24" FontWeight="Bold" Foreground="#364654" HorizontalAlignment="Center"/>
                                <TextBlock Text="A imagem recebida aparecerá aqui" Foreground="#697987" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="2,12,2,0">
                        <TextBlock Text="STATUS" Foreground="#9AA8B5" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="Pronto. Inicie uma sessão ou conecte-se a um transmissor." Foreground="#43E08B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Foreground="#9AA8B5" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap">Limitação atual: captura GDI + JPEG por TCP, até 1920 px de largura e 30 FPS configuráveis. Não representa o pipeline final 4K/165 FPS.</TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Foreground="#697987" FontSize="11" Text="ScreenFlow Remote · Windows 10/11 · A transmissão só inicia após aprovação local." VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Atualizar monitores" Margin="8,0,0,0" Padding="10,5" Click="RefreshMonitors_Click"/>
        </DockPanel>
    </Grid>
</Window>