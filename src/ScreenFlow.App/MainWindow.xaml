<Window x:Class="ScreenFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenFlow" Width="1320" Height="860" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/screenflow.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontUi}" FontSize="{DynamicResource FontSizeBody}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────────── Menu lateral ───────────── -->
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,0,16,18">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,18,0,30">
                    <Border Width="44" Height="44" CornerRadius="13" Background="#0E1733" BorderBrush="#2C3E78" BorderThickness="1">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Data="M7.2,19.2 L11.2,4.8 M13.4,19.2 L17.4,4.8" StrokeThickness="4.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource BrandGradient}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel x:Name="BrandText" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ScreenFlow" FontFamily="{DynamicResource FontDisplay}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="1,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Este computador -->
                <Border x:Name="MachineCard" DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="14" Padding="12">
                    <DockPanel>
                        <Border Style="{StaticResource IconTile}" Width="38" Height="38" CornerRadius="10" TextElement.FontSize="16" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;"/>
                        </Border>
                        <StackPanel x:Name="MachinePanel" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Este computador" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="MachineText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse x:Name="RadminDot" Width="7" Height="7" Fill="{DynamicResource TextSubtle}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RadminText" Style="{StaticResource Caption}" Margin="6,0,0,0" Text="Verificando o Radmin…" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Navegação -->
                <StackPanel x:Name="Nav">
                    <RadioButton x:Name="NavOverview" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xF0E2;" Content="Visão geral" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTransmit" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE714;" Content="Transmissão" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavWatch" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE768;" Content="Assistir" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavMonitor" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE95E;" Content="Monitoramento" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE9E9;" Content="Configurações" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavUpdates" GroupName="nav" Style="{StaticResource NavItem}" Tag="&#xE895;" Content="Atualizações" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ───────────── Conteúdo ───────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="2" Background="{DynamicResource PageGlow}" IsHitTestVisible="False"/>

            <!-- Barra superior (arrasta a janela) -->
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                <DockPanel Margin="22,0,12,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE700;" ToolTip="Recolher o menu" Click="ToggleSidebar_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14">
                        <Run Text="ScreenFlow" Foreground="{DynamicResource TextSubtle}"/><Run Text="   /   " Foreground="{DynamicResource TextSubtle}"/><Run x:Name="CrumbPage" Text="Visão geral" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    </TextBlock>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusPill" Style="{StaticResource Pill}" Padding="12,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect x:Name="StatusGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.9" Color="#2EE6A6"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" Text="Disponível"/>
                            </StackPanel>
                        </Border>
                        <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="BellButton" Style="{StaticResource IconButton}" Content="&#xEA8F;" ToolTip="Notificações" Click="Bell_Click"/>
                            <Border x:Name="BellBadge" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,1,0"
                                    MinWidth="17" Height="17" CornerRadius="8.5" Background="{DynamicResource LiveGradient}" Padding="4,0" Visibility="Collapsed">
                                <TextBlock x:Name="BellCount" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="&#xE708;" ToolTip="Tema claro ou escuro" Click="Theme_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True" Margin="2,0,0,0"/>
                        <Border Width="1" Height="22" Background="{DynamicResource Border}" Margin="10,0,6,0"/>
                        <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimizar" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;" ToolTip="Maximizar" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Fechar" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl x:Name="Host" Grid.Row="1" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="HostTranslate"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Avisos rápidos -->
        <StackPanel x:Name="Toasts" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,26" Width="400"/>

        <!-- Notificações (sininho) -->
        <Popup x:Name="NotificationsPopup" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom" HorizontalOffset="-368" VerticalOffset="2"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="NotificationsPopup_Closed">
            <Border Width="392" Margin="14,4,14,20" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    CornerRadius="18" Padding="0,0,0,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="18,14,16,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Marcar como lidas" FontSize="12.5" Click="MarkRead_Click"/>
                        <TextBlock Text="Notificações" FontSize="15.5" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Border Style="{StaticResource DividerLine}"/>
                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NoticeList" Margin="8,8,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="12" Padding="12" Margin="0,0,0,4" Background="Transparent">
                                        <DockPanel>
                                            <Border Style="{StaticResource IconTile}" Width="36" Height="36" CornerRadius="10" TextElement.FontSize="15">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Caption}" Margin="8,1,0,0"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="13" LineHeight="19" Margin="0,3,0,0"/>
                                                <Button Content="{Binding ActionText}" Tag="{Binding}" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="14,0"
                                                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="NoticeAction_Click"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRead}" Value="False">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="NoNotices" Margin="0,22,0,18" HorizontalAlignment="Center">
                        <Border Style="{StaticResource IconTile}" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;"/>
                        </Border>
                        <TextBlock Text="Tudo em dia" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                        <TextBlock Text="Avisos de versão nova e da rede aparecem aqui." Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
