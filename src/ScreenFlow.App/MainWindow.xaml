<Window x:Class="ScreenFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenFlow" Width="1200" Height="820" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Assets/screenflow.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource FontUi}" FontSize="{DynamicResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Voltar" Click="Back_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Image Source="Assets/screenflow.ico" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="ScreenFlow" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="PageTitle" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Configurações" Click="Settings_Click"/>
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE706;" ToolTip="Alternar tema claro/escuro" Click="Theme_Click"/>
            </DockPanel>
        </Border>

        <!-- Avisos (atualização, configuração automática, firewall) -->
        <StackPanel x:Name="Banners" Grid.Row="1" Margin="24,16,24,0"/>

        <ContentControl x:Name="Host" Grid.Row="2" Focusable="False"/>

        <!-- Barra de status -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse x:Name="RadminDot" Width="8" Height="8" Fill="{DynamicResource TextSubtle}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RadminStatus" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Text="Verificando Radmin VPN…"/>
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
