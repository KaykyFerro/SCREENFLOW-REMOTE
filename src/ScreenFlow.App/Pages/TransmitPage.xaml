<UserControl x:Class="ScreenFlow.App.Pages.TransmitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenFlow.App.Controls">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{DynamicResource ContentMaxWidth}">
            <DockPanel Margin="0,22,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LiveBadge" Style="{StaticResource Pill}" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource TextSubtle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LiveText" Text="Parado"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" MinHeight="46" Click="Start_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StartGlyph" Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StartText" Text="Iniciar transmissão" FontSize="15"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource LiveButton}" MinHeight="46" Click="Stop_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Margin="0,0,10,0"/>
                            <TextBlock Text="Encerrar" FontSize="15"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Transmissão"/>
            </DockPanel>
            <TextBlock x:Name="StateText" Style="{StaticResource Subtitle}" Margin="0,0,0,24" Text="Escolha o que compartilhar e clique em Iniciar."/>

            <!-- O que compartilhar -->
            <UniformGrid x:Name="ModeGrid" Columns="3" Margin="0,0,-16,20">
                <RadioButton x:Name="ModeScreen" GroupName="mode" Style="{StaticResource ModeCard}" Margin="0,0,16,0" Checked="Mode_Checked">
                    <StackPanel>
                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;"/>
                        </Border>
                        <TextBlock Style="{StaticResource Heading}" Text="Tela" Margin="0,14,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Text="Monitor ou janela, até 4K a 165 FPS, com o som do PC."/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeCamera" GroupName="mode" Style="{StaticResource ModeCard}" Margin="0,0,16,0" Checked="Mode_Checked">
                    <StackPanel>
                        <Border Style="{StaticResource IconTileCyan}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B8;"/>
                        </Border>
                        <TextBlock Style="{StaticResource Heading}" Text="Câmera" Margin="0,14,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Text="Webcam ou placa de captura. Só liga quando alguém entra."/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeParty" GroupName="mode" Style="{StaticResource ModeCard}" Margin="0,0,16,0" Checked="Mode_Checked">
                    <StackPanel>
                        <Border Style="{StaticResource IconTilePink}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;"/>
                        </Border>
                        <TextBlock Style="{StaticResource Heading}" Text="Festa de música" Margin="0,14,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Text="Só o som do PC, em qualidade de música, sem vídeo."/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <Grid x:Name="Columns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Coluna da esquerda: opções -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="OptionsPanel">
                            <TextBlock x:Name="OptionsTitle" Style="{StaticResource Heading}" Text="Tela" Margin="0,0,0,18"/>

                            <StackPanel x:Name="ScreenOptions">
                                <TextBlock Style="{StaticResource Label}" Text="Monitor ou janela"/>
                                <DockPanel x:Name="SourceRow" Margin="{DynamicResource FieldGap}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Atualizar a lista" Click="RefreshSources_Click" Margin="8,0,0,0"/>
                                    <ComboBox x:Name="SourceCombo"/>
                                </DockPanel>
                                <Grid Margin="{DynamicResource FieldGap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="Resolução"/>
                                        <ComboBox x:Name="QualityCombo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label}" Text="FPS"/>
                                        <ComboBox x:Name="FpsCombo"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="CameraWithScreenToggle" Style="{StaticResource Switch}" Content="Mandar a câmera junto"
                                          ToolTip="Quem assiste vê a sua webcam num quadrinho no canto da tela."
                                          Checked="CameraWithScreen_Changed" Unchecked="CameraWithScreen_Changed"/>
                                <StackPanel x:Name="OverlayCameraPanel" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Label}" Text="Câmera que vai junto"/>
                                    <DockPanel Margin="{DynamicResource FieldGap}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Procurar câmeras de novo" Click="RefreshCameras_Click" Margin="8,0,0,0"/>
                                        <ComboBox x:Name="OverlayCameraCombo"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="CameraOptions" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Label}" Text="Câmera"/>
                                <DockPanel x:Name="CameraRow" Margin="{DynamicResource FieldGap}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Procurar câmeras de novo" Click="RefreshCameras_Click" Margin="8,0,0,0"/>
                                    <ComboBox x:Name="CameraCombo"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Qualidade"/>
                                <ComboBox x:Name="CameraQualityCombo" Margin="{DynamicResource FieldGap}"/>
                            </StackPanel>

                            <StackPanel x:Name="PartyOptions" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Label}" Text="O que toca na festa"/>
                                <DockPanel Margin="{DynamicResource FieldGap}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Procurar os apps de novo" Click="RefreshPartyApps_Click" Margin="8,0,0,0"/>
                                    <ComboBox x:Name="PartyAppCombo" ToolTip="Escolha o app da música para ninguém ouvir notificações, jogos e o resto do PC. Dá para trocar com a festa no ar."/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Qualidade do som"/>
                                <ComboBox x:Name="MusicCombo" Margin="{DynamicResource FieldGap}"/>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,14">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource Violet}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                        <TextBlock x:Name="PartyInfoText" Style="{StaticResource Muted}" FontSize="13" LineHeight="19"
                                                   Text="Toca tudo o que sai no som do PC (Spotify, YouTube, jogos). Opus estéreo 48 kHz, com cópia de cada pacote no seguinte: se um se perder na rede, ninguém percebe."/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <CheckBox x:Name="FixedQualityToggle" Style="{StaticResource Switch}" Content="Qualidade fixa (não baixa sozinha quando a rede aperta)"
                                      ToolTip="Fica sempre na resolução e no FPS escolhidos. Dá para trocar a qualidade a qualquer momento, até durante a transmissão."
                                      Checked="FixedQuality_Changed" Unchecked="FixedQuality_Changed"/>
                            <CheckBox x:Name="AudioToggle" Style="{StaticResource Switch}" Content="Compartilhar o som do PC"/>
                            <TextBlock x:Name="ProfileHint" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="AccessPanel">
                            <TextBlock Style="{StaticResource Heading}" Text="Quem pode entrar" Margin="0,0,0,16"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Seu IP do Radmin"/>
                            <DockPanel Margin="0,2,0,0">
                                <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copiar o IP" Click="Copy_Click" VerticalAlignment="Center"/>
                                <TextBlock x:Name="IpText" FontFamily="{DynamicResource FontDisplay}" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentText}" Text="—"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock x:Name="IpHint" Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Passe este IP para quem vai assistir."/>

                            <Border x:Name="RadminMissing" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="{DynamicResource RadiusLg}" Padding="14,12"
                                    Background="{DynamicResource AmberSoft}">
                                <StackPanel>
                                    <TextBlock x:Name="RadminMissingText" Style="{StaticResource Body}" FontSize="13" Foreground="{DynamicResource Amber}" TextWrapping="Wrap"
                                               Text="O Radmin VPN não está conectado. Instale, entre na mesma rede que os outros e tente de novo."/>
                                    <ProgressBar x:Name="RadminProgress" Height="6" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="RadminActionButton" Content="Instalar o Radmin VPN" MinHeight="34" Click="RadminAction_Click"/>
                                        <Button Content="Tentar de novo" MinHeight="34" Margin="8,0,0,0" Click="RefreshNetwork_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Label}" Text="Rede usada" Margin="0,18,0,7"/>
                            <ComboBox x:Name="AdapterCombo" SelectionChanged="Adapter_SelectionChanged"/>
                            <CheckBox x:Name="ApproveToggle" Style="{StaticResource Switch}" Content="Aprovar cada pessoa antes de entrar" Margin="0,18,0,16"/>
                            <TextBlock Style="{StaticResource Label}" Text="PIN (opcional)"/>
                            <TextBox x:Name="PinBox" Tag="Sem PIN" MaxLength="32" ToolTip="Deixe vazio para não pedir PIN. Mínimo de 4 caracteres."/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       Text="Qualquer pessoa na mesma rede Radmin alcança o seu IP. Use PIN ou aprovação para controlar quem entra."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Coluna da direita: ao vivo -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid x:Name="StatsGrid" Columns="4" Margin="0,0,-12,0" SizeChanged="StatsGrid_SizeChanged">
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="Assistindo"/>
                                        <TextBlock x:Name="StatViewers" Style="{StaticResource Stat}" Text="0" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock x:Name="StatFpsLabel" Style="{StaticResource Caption}" Text="FPS"/>
                                        <TextBlock x:Name="StatFps" Style="{StaticResource Stat}" Text="—" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock x:Name="StatBitrateLabel" Style="{StaticResource Caption}" Text="Vídeo"/>
                                        <TextBlock x:Name="StatBitrate" Style="{StaticResource Stat}" Text="—" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetCard}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="Upload total"/>
                                        <TextBlock x:Name="StatUpload" Style="{StaticResource Stat}" Text="—" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock x:Name="StatDetails" Style="{StaticResource Caption}" Margin="2,14,0,0" Text="Os números aparecem quando alguém entra."/>
                        </StackPanel>
                    </Border>

                    <!-- O que está tocando no PC (os controles de mídia do Windows): voltar, pausar, pular e ir para um ponto -->
                    <Border x:Name="MediaCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <ComboBox x:Name="MediaSessionCombo" DockPanel.Dock="Right" MinWidth="150" MaxWidth="220" VerticalAlignment="Top" Margin="12,0,0,0"
                                          Visibility="Collapsed" ToolTip="Mais de um app está tocando: escolha qual controlar"/>
                                <Grid Width="60" Height="60" VerticalAlignment="Center">
                                    <Border CornerRadius="14" Background="{DynamicResource BrandGradient}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="22" Foreground="{DynamicResource OnAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="MediaArt" CornerRadius="14" Visibility="Collapsed"/>
                                </Grid>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaApp" Style="{StaticResource Caption}" Text="Tocando agora"/>
                                    <TextBlock x:Name="MediaTitle" FontWeight="SemiBold" FontSize="15.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="MediaArtist" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid x:Name="MediaSeekRow" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MediaPosition" Style="{StaticResource Caption}" VerticalAlignment="Center" MinWidth="38" Text="0:00"/>
                                <Slider x:Name="MediaSeek" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="1" ToolTip="Arraste para ir a outro ponto"
                                        PreviewMouseLeftButtonDown="MediaSeek_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="MediaSeek_PreviewMouseLeftButtonUp"
                                        ValueChanged="MediaSeek_ValueChanged"/>
                                <TextBlock x:Name="MediaDuration" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" MinWidth="38"
                                           TextAlignment="Right" Text="0:00"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button x:Name="MediaPrevious" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Voltar" Click="MediaPrevious_Click"/>
                                <Button x:Name="MediaPlayPause" Style="{StaticResource PrimaryButton}" Width="52" Height="44" Padding="0" Margin="16,0"
                                        HorizontalContentAlignment="Center" ToolTip="Pausar" Click="MediaPlayPause_Click">
                                    <TextBlock x:Name="MediaPlayGlyph" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="16"/>
                                </Button>
                                <Button x:Name="MediaNext" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Pular" Click="MediaNext_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AudioCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="LevelPill" DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                    <TextBlock x:Name="AudioState" Text="Sem som"/>
                                </Border>
                                <Border Style="{StaticResource IconTilePink}" Width="38" Height="38" CornerRadius="10" TextElement.FontSize="16" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Heading}" FontSize="16" Text="Som do PC"/>
                                    <TextBlock x:Name="AudioDescription" Style="{StaticResource Caption}" Text="O visualizador mexe quando a transmissão começa."/>
                                </StackPanel>
                            </DockPanel>
                            <controls:SpectrumVisualizer x:Name="Spectrum" Height="150" Margin="0,20,0,0" BarGap="5" Mirror="True"/>

                            <!-- O que fica fora do som transmitido: a voz da rede, os sons do ScreenFlow e os apps escolhidos -->
                            <Border Style="{StaticResource InsetCard}" Margin="0,18,0,0">
                                <DockPanel>
                                    <Button x:Name="ChooseAppsButton" DockPanel.Dock="Right" Content="Escolher apps" MinHeight="34" Padding="14,0" Margin="12,0,0,0"
                                            VerticalAlignment="Center" Click="ChooseApps_Click"/>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE74F;" Foreground="{DynamicResource Pink}"
                                               VerticalAlignment="Top" Margin="0,3,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Fica fora da transmissão" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MutedAppsText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Popup x:Name="AppsPopup" PlacementTarget="{Binding ElementName=ChooseAppsButton}" Placement="Bottom" VerticalOffset="2"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="AppsPopup_Closed">
                                <Border Width="380" Margin="14,4,14,20" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource BorderStrong}"
                                        BorderThickness="1" CornerRadius="18" Padding="0,0,0,14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="18,12,10,2">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Procurar os apps de novo"
                                                    Click="RefreshApps_Click"/>
                                            <TextBlock Text="Tirar o som de apps" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Margin="18,0,18,12" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                   Text="Marque os apps que quem assiste não deve ouvir. A voz da rede e os sons do ScreenFlow já ficam de fora."/>
                                        <Border Style="{StaticResource DividerLine}"/>
                                        <TextBlock x:Name="AppsStatus" Margin="18,14,18,4" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Procurando os apps abertos…"/>
                                        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="AppsList" Margin="10,6,10,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Muted, Mode=TwoWay}" Margin="8,5" ToolTip="{Binding Exe}">
                                                            <DockPanel>
                                                                <Grid Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <Border x:Name="Fallback" CornerRadius="8" Background="{DynamicResource BrandGradient}" Visibility="Collapsed">
                                                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OnAccent}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Grid>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontWeight="Normal"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </CheckBox>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <DockPanel Margin="18,12,18,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Pronto" MinHeight="34" Padding="18,0" Margin="12,0,0,0"
                                                    Click="AppsDone_Click"/>
                                            <TextBlock x:Name="AppsHint" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Text="Vale na hora, até no meio da transmissão."/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ApprovalCard" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="{DynamicResource AccentBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Pedindo para entrar"/>
                            <ItemsControl x:Name="ApprovalList" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Recusar" MinHeight="36" Margin="8,0,0,0" Click="Deny_Click" Tag="{Binding}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Aceitar" MinHeight="36" Click="Approve_Click" Tag="{Binding}"/>
                                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource BrandGradient}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ViewerCount" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Heading}" Text="Quem está assistindo"/>
                            </DockPanel>
                            <TextBlock x:Name="NoViewers" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Ninguém ainda. Quem estiver na sua rede Radmin vê você na tela Assistir, ou entra digitando o seu IP."/>
                            <ItemsControl x:Name="ViewerList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remover da transmissão" Click="Kick_Click" Tag="{Binding Id}"/>
                                                <Button DockPanel.Dock="Right" Content="{Binding TestText}" IsEnabled="{Binding CanTest}" MinHeight="34" Padding="12,0" Margin="8,0,6,0"
                                                        FontSize="12.5" Click="Bandwidth_Click" Tag="{Binding Id}" ToolTip="Mede a banda até esta pessoa por 3 segundos"/>
                                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource BrandGradient}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  " /><Run Text="{Binding Address, Mode=OneWay}" Foreground="{DynamicResource TextSubtle}" FontWeight="Normal" FontSize="12.5"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
