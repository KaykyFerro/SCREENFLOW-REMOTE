<UserControl x:Class="ScreenFlow.App.Pages.WatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="24">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Assistir uma transmissão"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16" Text="Digite o IP do Radmin de quem está transmitindo. A conexão acontece sozinha."/>
                    <TextBlock Style="{StaticResource Label}" Text="IP DO HOST"/>
                    <DockPanel>
                        <Button x:Name="ConnectButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Conectar" MinWidth="140" Margin="12,0,0,0" Click="Connect_Click" IsDefault="True"/>
                        <ComboBox x:Name="HostBox" IsEditable="True" FontSize="18"/>
                    </DockPanel>
                    <Border x:Name="StatePanel" Visibility="Collapsed" Margin="0,16,0,0" Padding="14,10" CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource SurfaceRaised}">
                        <DockPanel>
                            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancelar" Click="Cancel_Click"/>
                            <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="StateText" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="ScanText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="Procurando…"/>
                        <TextBlock Style="{StaticResource Heading}" Text="Transmissões na sua rede Radmin"/>
                    </DockPanel>
                    <TextBlock x:Name="NoHosts" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Nenhuma encontrada ainda. Quando alguém na mesma rede começar a transmitir, aparece aqui. Se não aparecer, digite o IP acima."/>
                    <ListBox x:Name="HostList" Margin="0,12,0,0" MouseDoubleClick="HostList_DoubleClick" SelectionChanged="HostList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding Subtitle}"/>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
