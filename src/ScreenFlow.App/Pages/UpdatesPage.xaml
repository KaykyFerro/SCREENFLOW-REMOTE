<UserControl x:Class="ScreenFlow.App.Pages.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{DynamicResource ContentMaxWidth}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Atualizações" Margin="0,22,0,6"/>
            <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,26"
                       Text="O ScreenFlow se atualiza sozinho: baixa o instalador oficial do GitHub, confere o arquivo e reabre na versão nova."/>

            <!-- Versão -->
            <Grid Margin="{DynamicResource StackGap}">
                <Border CornerRadius="{DynamicResource RadiusXl}">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/aurora.jpg" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top"/>
                    </Border.Background>
                </Border>
                <Border x:Name="HeroTint" CornerRadius="{DynamicResource RadiusXl}" Background="{DynamicResource PartyGradient}" Opacity="0"/>
                <Border CornerRadius="{DynamicResource RadiusXl}" Background="{DynamicResource HeroScrim}" BorderBrush="#26FFFFFF" BorderThickness="1"/>
                <StackPanel Margin="32,30" TextElement.Foreground="#FFFFFF">
                    <Grid x:Name="HeroLayout" SizeChanged="HeroLayout_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button x:Name="CheckButton" MinHeight="46" Padding="20,0" Background="#330B1430" BorderBrush="#40FFFFFF" Foreground="#FFFFFF" Click="Check_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="CheckText" Text="Procurar agora"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" MinHeight="46" Padding="22,0" Margin="12,0,0,0" Click="Install_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="InstallText" Text="Atualizar agora" FontSize="15"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DockPanel>
                            <Border Width="64" Height="64" CornerRadius="18" Background="#0E1733" BorderBrush="#2C3E78" BorderThickness="1" VerticalAlignment="Center">
                                <Viewbox Width="36" Height="36">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M7.2,19.2 L11.2,4.8 M13.4,19.2 L17.4,4.8" StrokeThickness="4.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{DynamicResource BrandGradient}"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionTitle" FontFamily="{DynamicResource FontDisplay}" FontSize="28" FontWeight="Bold" Text="ScreenFlow"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#3DF0B0" VerticalAlignment="Top" Margin="0,7,9,0"/>
                                    <TextBlock x:Name="StatusText" FontSize="14.5" Foreground="#C8D3EC" TextWrapping="Wrap" Text="Você está na versão mais recente."/>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <StackPanel x:Name="ProgressPanel" Margin="0,24,0,0" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" FontWeight="Bold" Text="0%"/>
                            <TextBlock x:Name="ProgressText" Foreground="#C8D3EC" Text="Baixando o instalador…"/>
                        </DockPanel>
                        <ProgressBar x:Name="DownloadBar" Height="8" Maximum="1" Background="#33FFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="Columns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Novidades -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,18">
                            <Border x:Name="NotesBadge" DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{DynamicResource PinkSoft}" BorderBrush="{DynamicResource PinkSoft}"
                                    TextElement.Foreground="{DynamicResource Pink}" Visibility="Collapsed">
                                <TextBlock Text="Nova"/>
                            </Border>
                            <Border Style="{StaticResource IconTileViolet}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE789;"/>
                            </Border>
                            <TextBlock x:Name="NotesTitle" Style="{StaticResource Heading}" Margin="14,0,0,0" VerticalAlignment="Center" Text="Novidades desta versão"/>
                        </DockPanel>
                        <StackPanel x:Name="NotesPanel"/>
                        <Button x:Name="SkipButton" Style="{StaticResource LinkButton}" Content="Pular esta versão" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="Skip_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Preferências -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <Border Style="{StaticResource IconTileCyan}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;"/>
                                </Border>
                                <TextBlock Style="{StaticResource Heading}" Margin="14,0,0,0" VerticalAlignment="Center" Text="Avisos"/>
                            </DockPanel>
                            <CheckBox x:Name="AutoToggle" Style="{StaticResource Switch}" Content="Procurar sozinho (ao abrir e a cada 6 horas) e avisar no sininho"
                                      Checked="AutoToggle_Changed" Unchecked="AutoToggle_Changed"/>
                            <Border Style="{StaticResource DividerLine}" Margin="0,18"/>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="LastCheckText" DockPanel.Dock="Right" Style="{StaticResource Body}" FontSize="13.5" Text="Nunca"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Última verificação"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock x:Name="InstalledText" DockPanel.Dock="Right" Style="{StaticResource Body}" FontSize="13.5"/>
                                <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Versão instalada"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" FontSize="16" Text="Como funciona"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" LineHeight="20" Margin="0,8,0,0"
                                       Text="Ao atualizar, uma transmissão ou player aberto é encerrado, o instalador roda sem perguntar nada e o ScreenFlow abre de novo na versão nova. As suas configurações ficam como estão."/>
                            <Button Style="{StaticResource LinkButton}" Content="Ver todas as versões no GitHub" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Releases_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
