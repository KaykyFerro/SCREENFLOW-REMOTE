<UserControl x:Class="ScreenFlow.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenFlow.App.Controls">
    <UserControl.Resources>
        <!-- Aba das configurações (ícone e nome; a escolhida fica destacada) -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="17" Padding="15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="{TemplateBinding Tag}" Margin="0,0,9,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- (1.4.1) Uma bolinha de cor do tema: a escolhida ganha um anel e um ✓ -->
        <Style x:Key="ColorSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Text}" StrokeThickness="2" Opacity="0"/>
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}"/>
                            <TextBlock x:Name="Check" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Uma linha de atalho do player: a tecla e o que ela faz -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource FontMono}"/>
            <Setter Property="TextElement.FontSize" Value="12"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroller" Style="{StaticResource PageScroll}">
        <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="{DynamicResource ContentMaxWidth}">
            <DockPanel Margin="0,22,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Style="{StaticResource PrimaryButton}" MinHeight="44" Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" Margin="0,0,10,0"/>
                            <TextBlock Text="Salvar alterações"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Configurações"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Subtitle}" Margin="0,0,0,18"
                       Text="Tudo já vem configurado para este PC: mude só o que quiser. Cada aba cuida de um assunto."/>

            <!-- Abas -->
            <Border HorizontalAlignment="Left" Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="21" Padding="4" Margin="0,0,0,22">
                <WrapPanel>
                    <RadioButton x:Name="TabGeneral" GroupName="settingsTab" Style="{StaticResource TabButton}" Tag="&#xE77B;" Content="Geral" IsChecked="True"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabStream" GroupName="settingsTab" Style="{StaticResource TabButton}" Tag="&#xE714;" Content="Transmissão" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabPlayer" GroupName="settingsTab" Style="{StaticResource TabButton}" Tag="&#xE768;" Content="Assistir" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabVoice" GroupName="settingsTab" Style="{StaticResource TabButton}" Tag="&#xE720;" Content="Voz e sala" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabServer" GroupName="settingsTab" Style="{StaticResource TabButton}" Tag="&#xE753;" Content="Servidor" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabNetwork" GroupName="settingsTab" Style="{StaticResource TabButton}" Tag="&#xE968;" Content="Rede e diagnóstico"
                                 Checked="Tab_Checked"/>
                </WrapPanel>
            </Border>

            <!-- ═════════════ Geral ═════════════ -->
            <Grid x:Name="GeneralColumns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Seu perfil -->
                <Border x:Name="ProfileCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <Border Style="{StaticResource IconTileCyan}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Seu perfil"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Como você aparece na sala, na voz e para quem assiste."/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <controls:AvatarView x:Name="ProfilePhoto" Width="84" Height="84" TextElement.FontSize="32" VerticalAlignment="Top" Margin="0,2,18,0"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Seu nome"/>
                                <TextBox x:Name="NameBox" MaxLength="40" Tag="Como quer ser chamado" TextChanged="NameBox_TextChanged"/>
                                <TextBlock x:Name="NameHint" Style="{StaticResource Caption}" Margin="0,6,0,12" TextWrapping="Wrap"
                                           Text="Aparece para todo mundo da rede no lugar do nome do PC. Vale quando você salvar."/>
                                <WrapPanel>
                                    <Button x:Name="ChoosePhotoButton" MinHeight="34" Padding="14,0" Margin="0,0,8,0" Click="ChoosePhoto_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ChoosePhotoLabel" Text="Escolher foto" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RemovePhotoButton" Style="{StaticResource GhostButton}" MinHeight="34" Padding="12,0"
                                            Content="Tirar a foto" Click="RemovePhoto_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Aparência e janela -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <Border Style="{StaticResource IconTileViolet}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE790;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Aparência e janela"/>
                                <TextBlock Style="{StaticResource Caption}" Text="O tema, a cor e o que acontece ao fechar a janela."/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Tema"/>
                        <ComboBox x:Name="ThemeCombo" Margin="{DynamicResource FieldGap}" AutomationProperties.Name="Tema escuro ou claro"/>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock x:Name="ColorName" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Bottom"/>
                            <TextBlock Style="{StaticResource Label}" Text="Cor" Margin="0"/>
                        </DockPanel>
                        <!-- Duas fileiras de 5, em qualquer largura (numa só, a 10ª sobrava sozinha embaixo) -->
                        <UniformGrid x:Name="ColorSwatches" Columns="5" HorizontalAlignment="Left" Margin="-5,0,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16" TextWrapping="Wrap"
                                   Text="O tema e a cor valem na hora e só neste PC: cada pessoa escolhe os seus."/>
                        <CheckBox x:Name="TrayToggle" Style="{StaticResource Switch}" Margin="0,0,0,14"
                                  Content="Fechar (X) leva o ScreenFlow para a bandeja, perto do relógio (a transmissão, a voz e o chat continuam). Minimizar deixa na barra de tarefas"/>
                        <CheckBox x:Name="ReopenToggle" Style="{StaticResource Switch}"
                                  Content="Abrir o ScreenFlow de novo quando a transmissão acabar ou o player fechar (se ele estiver na bandeja)"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═════════════ Transmissão ═════════════ -->
            <StackPanel x:Name="StreamPanel" Visibility="Collapsed">
                <!-- Configuração automática -->
                <Grid Margin="{DynamicResource StackGap}">
                    <Border CornerRadius="{DynamicResource RadiusXl}">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/aurora.jpg" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="{DynamicResource RadiusXl}" Background="{DynamicResource HeroScrim}" BorderBrush="#26FFFFFF" BorderThickness="1"/>
                    <DockPanel Margin="28,22" TextElement.Foreground="#FFFFFF">
                        <Button x:Name="AutoButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinHeight="46" VerticalAlignment="Center" Margin="20,0,0,0" Click="Auto_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Margin="0,0,10,0"/>
                                <TextBlock Text="Detectar e configurar de novo"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource IconTile}" Background="#262EE6A6" BorderBrush="#552EE6A6" TextElement.Foreground="#5DF5C2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9F5;"/>
                        </Border>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Configuração automática" FontFamily="{DynamicResource FontDisplay}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="AutoResult" FontSize="13.5" Foreground="#C8D3EC" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="20"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <Grid x:Name="StreamColumns">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vídeo -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,20">
                                <Border Style="{StaticResource IconTile}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Heading}" Text="Transmissão de tela"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Valores iniciais; dá para mudar na hora de transmitir."/>
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="{DynamicResource FieldGap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Resolução"/>
                                    <ComboBox x:Name="QualityCombo"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Text="FPS"/>
                                    <ComboBox x:Name="FpsCombo"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="Encoder"/>
                            <ComboBox x:Name="EncoderCombo" Margin="{DynamicResource FieldGap}"/>
                            <Grid Margin="{DynamicResource FieldGap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Bitrate por pessoa (Mbps)"/>
                                    <TextBox x:Name="BitrateBox" Tag="Automático"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label}" Text="Correção de perdas (FEC)"/>
                                    <ComboBox x:Name="FecCombo"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="AdaptiveToggle" Style="{StaticResource Switch}" Content="Qualidade adaptativa: baixa a bitrate, depois o FPS e por último a resolução quando a rede não aguenta"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <!-- Câmera, som e festa -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,20">
                                    <Border Style="{StaticResource IconTilePink}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Heading}" Text="Câmera, som e festa de música"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Qualidade da webcam e do áudio."/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Qualidade da câmera"/>
                                <ComboBox x:Name="CameraQualityCombo" Margin="{DynamicResource FieldGap}"/>
                                <Grid Margin="{DynamicResource FieldGap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="Som na tela e na câmera"/>
                                        <ComboBox x:Name="AudioBitrateCombo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label}" Text="Som na festa de música"/>
                                        <ComboBox x:Name="MusicCombo"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="KeepVolumeToggle" Style="{StaticResource Switch}" Margin="0,0,0,6"
                                          Content="O volume do seu PC não muda o som da transmissão: cada pessoa controla o próprio volume"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                                           Text="Abaixar ou tirar o som do Windows aqui só muda o que você ouve. Desligue se quiser que quem assiste ouça no mesmo volume que você."/>
                                <CheckBox x:Name="SeparateAudioToggle" Style="{StaticResource Switch}" Margin="0,0,0,6"
                                          Content="Separar o som por app: a voz da rede e os apps escolhidos ficam fora da transmissão"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Os apps são escolhidos no cartão Som do PC, na tela Transmissão. O som é Opus estéreo 48 kHz e, na festa de música, cada pacote vai duas vezes (cópia de segurança)."/>
                            </StackPanel>
                        </Border>

                        <!-- Quem pode entrar -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,20">
                                    <Border Style="{StaticResource IconTileAmber}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;"/>
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Heading}" Text="Quem pode entrar"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Já vem liberado para quem está na sua rede do Radmin entrar direto."/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Label}" Text="PIN padrão (opcional)"/>
                                <TextBox x:Name="PinBox" MaxLength="32" Tag="Sem PIN" Margin="{DynamicResource FieldGap}"/>
                                <CheckBox x:Name="ApproveToggle" Style="{StaticResource Switch}" Margin="0,0,0,6" Content="Aprovar cada pessoa antes de mostrar a tela"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Desligado, quem está na sua rede entra sem precisar de permissão. Ligue se quiser aceitar uma pessoa de cada vez."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ═════════════ Assistir ═════════════ -->
            <Grid x:Name="PlayerColumns" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Player -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <Border Style="{StaticResource IconTileCyan}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Player"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Como as transmissões aparecem para você."/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox x:Name="GpuToggle" Style="{StaticResource Switch}" Content="Desenhar o vídeo direto na GPU (mais leve e com menos atraso)" Margin="0,0,0,14"/>
                        <CheckBox x:Name="StatsToggle" Style="{StaticResource Switch}" Content="Mostrar as estatísticas no player (F3)" Margin="0,0,0,14"/>
                        <CheckBox x:Name="MediaControlsToggle" Style="{StaticResource Switch}" Margin="0,0,0,6"
                                  Content="Aparecer como player de mídia do Windows: no painel do volume, na tela de bloqueio e nas teclas de mídia"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Mostra a música da festa (ou a transmissão), com a capa, e responde aos botões de tocar, pausar e pular do teclado e do fone. Apps que mostram o que está tocando também veem o ScreenFlow. Vale na próxima vez que o player abrir."/>
                    </StackPanel>
                </Border>

                <!-- Atalhos do player -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,18">
                            <Border Style="{StaticResource IconTileBlue}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE92E;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Atalhos do player"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Funcionam com a janela do player na frente."/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="120">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="F"/></Border>
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="F11"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" VerticalAlignment="Center" Text="Tela cheia (Esc sai)"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="120">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="M"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" VerticalAlignment="Center" Text="Tirar e voltar o som"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="120">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="↑"/></Border>
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="↓"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" VerticalAlignment="Center" Text="Volume (só para você)"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="120">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="C"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" VerticalAlignment="Center" Text="Mostrar ou esconder a câmera"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="120">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="F3"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" VerticalAlignment="Center" Text="Estatísticas da conexão"/>
                        </DockPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Width="120">
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="⏯"/></Border>
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="⏭"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="13.5" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Teclas de mídia: tocar, pausar e pular a música (quando quem transmite deixa)"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═════════════ Voz e sala ═════════════ -->
            <Grid x:Name="VoiceColumns" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Voz da rede -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <Border Style="{StaticResource IconTile}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE720;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Voz da rede"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Microfone e som dos canais de voz da sala."/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Microfone"/>
                        <DockPanel Margin="{DynamicResource FieldGap}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Procurar microfones de novo" Margin="8,0,0,0"
                                    Click="RefreshMicrophones_Click"/>
                            <ComboBox x:Name="MicrophoneCombo"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="MicGainValue" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Label}" Text="Volume do microfone" Margin="0"/>
                        </DockPanel>
                        <Slider x:Name="MicGainSlider" Minimum="-12" Maximum="24" SmallChange="1" LargeChange="3" TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,0,14" ValueChanged="MicGain_Changed" AutomationProperties.Name="Volume do microfone"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="SensitivityValue" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Label}" Text="Sensibilidade do microfone" Margin="0"/>
                        </DockPanel>
                        <Slider x:Name="SensitivitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="Sensitivity_Changed"/>
                        <!-- Medidor: o volume do microfone e a marca a partir da qual a voz vai pela rede -->
                        <Grid x:Name="MicMeter" Height="10" Margin="0,10,0,10" SizeChanged="MicMeter_SizeChanged">
                            <Border CornerRadius="5" Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                            <Border x:Name="MicLevel" CornerRadius="5" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentGradient}"/>
                            <Border x:Name="MicThreshold" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,-4" Background="{DynamicResource Text}"
                                    ToolTip="A voz só vai pela rede quando passa desta marca."/>
                        </Grid>
                        <DockPanel Margin="{DynamicResource FieldGap}">
                            <Button x:Name="MicTestButton" DockPanel.Dock="Right" Content="Testar microfone" MinHeight="34" MinWidth="172" Padding="14,0" Margin="12,0,0,0" Click="MicTest_Click"/>
                            <TextBlock x:Name="MicTestText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="Fale normalmente: a barra precisa passar da marca para a sua voz ir. Se não passar, puxe a sensibilidade para a direita."/>
                        </DockPanel>
                        <DockPanel Margin="{DynamicResource FieldGap}">
                            <Button x:Name="MicMonitorButton" DockPanel.Dock="Right" MinHeight="34" MinWidth="172" Padding="14,0" Margin="12,0,0,0" Click="MicMonitor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MicMonitorLabel" Text="Ouvir meu microfone" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="MicMonitorText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="Toca o seu microfone no fone, para você ouvir como a sua voz está saindo."/>
                        </DockPanel>
                        <CheckBox x:Name="AutoGainToggle" Style="{StaticResource Switch}" Margin="0,0,0,8" Click="AutoGain_Click"
                                  Content="Ajustar o volume do microfone sozinho (a sua voz chega no nível de uma chamada, sem estourar)"/>
                        <CheckBox x:Name="LevelerToggle" Style="{StaticResource Switch}" Margin="0,0,0,8"
                                  Content="Igualar o volume de quem fala (quem chega baixo, ou numa versão antiga, sobe um pouco)"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="O volume da voz de todo mundo fica no Mixer, ao lado. Para mudar o volume de uma pessoa só, clique com o botão direito nela na Sala da rede."/>
                        <TextBlock Style="{StaticResource Label}" Text="Saída do som da voz"/>
                        <DockPanel Margin="{DynamicResource FieldGap}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Procurar saídas de som de novo" Margin="8,0,0,0"
                                    Click="RefreshSpeakers_Click"/>
                            <ComboBox x:Name="SpeakerCombo" AutomationProperties.Name="Saída do som da voz"/>
                        </DockPanel>
                        <CheckBox x:Name="PushToTalkToggle" Style="{StaticResource Switch}" Margin="0,0,0,8"
                                  Content="Apertar para falar (a voz só vai enquanto a tecla está apertada, em qualquer app)"/>
                        <DockPanel Margin="0,0,0,14">
                            <Button x:Name="PushToTalkKeyButton" DockPanel.Dock="Right" MinHeight="34" MinWidth="172" Padding="14,0" Margin="12,0,0,0"
                                    Click="PushToTalkKey_Click" PreviewKeyDown="PushToTalkKey_PreviewKeyDown" PreviewMouseDown="PushToTalkKey_PreviewMouseDown"
                                    AutomationProperties.Name="Tecla de apertar para falar"/>
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Clique no botão e aperte a tecla (ou um botão lateral do mouse) que quer usar. Esc cancela."/>
                        </DockPanel>
                        <CheckBox x:Name="VoiceSoundsToggle" Style="{StaticResource Switch}" Margin="0,0,0,8" Content="Sons ao entrar, sair e desligar o microfone (como no Discord)"/>
                        <CheckBox x:Name="MessageSoundsToggle" Style="{StaticResource Switch}" Content="Som quando chega mensagem no chat ou numa conversa privada"/>
                    </StackPanel>
                </Border>

                <!-- Chat guardado -->
                <StackPanel Grid.Column="2">
                <!-- Mixer (1.5.0): três volumes separados, só do ScreenFlow -->
                <Border x:Name="MixerCard" Style="{StaticResource Card}" Margin="0,0,0,22">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,18">
                            <Border Style="{StaticResource IconTileViolet}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Mixer"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Três volumes separados, só do ScreenFlow: um não muda os outros e o volume do Windows fica como está. Vale na hora."/>
                            </StackPanel>
                        </DockPanel>
                        <controls:MixerPanel x:Name="MixerControls"/>
                    </StackPanel>
                </Border>
                <Border x:Name="ArchiveCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <Border Style="{StaticResource IconTileBlue}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE753;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Guardar o chat no Google Drive"/>
                                <TextBlock Style="{StaticResource Caption}" Text="As conversas ficam numa pasta que o Google Drive manda para a nuvem."/>
                            </StackPanel>
                        </DockPanel>
                        <CheckBox x:Name="ArchiveToggle" Style="{StaticResource Switch}" Margin="0,0,0,14" Click="ArchiveToggle_Click"
                                  Content="Guardar as conversas da sala (todos os canais, com as imagens)"/>
                        <Border Style="{StaticResource InsetCard}" Padding="14,12" Margin="0,0,0,14">
                            <DockPanel>
                                <Ellipse x:Name="ArchiveDot" Width="9" Height="9" Fill="{DynamicResource TextSubtle}" VerticalAlignment="Top" Margin="2,6,12,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="ArchiveStatus" Style="{StaticResource Body}" FontSize="13.5" Text="Desligado."/>
                                    <TextBlock x:Name="ArchivePath" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="ArchiveChooseButton" MinHeight="34" Padding="14,0" Margin="0,0,8,8" Click="ArchiveChoose_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Escolher outra pasta" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ArchiveDriveButton" Style="{StaticResource GhostButton}" MinHeight="34" Padding="12,0" Margin="0,0,8,8"
                                    Content="Voltar para o Google Drive" Click="ArchiveDrive_Click"/>
                            <Button x:Name="ArchiveOpenButton" Style="{StaticResource GhostButton}" MinHeight="34" Padding="12,0" Margin="0,0,8,8"
                                    Content="Abrir a pasta" Click="ArchiveOpen_Click"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Fica uma pasta ScreenFlow Chat com um arquivo de texto por canal e por dia, mais as imagens. Precisa do Google Drive para computador instalado e conectado; sem ele, escolha qualquer pasta. Quando o ScreenFlow abre, as últimas conversas voltam da pasta. Liga e desliga na hora."/>
                    </StackPanel>
                </Border>

                <!-- Sala privada e moderação (1.4.0): independente do PIN e da aprovação para assistir à transmissão -->
                <Border x:Name="PrivateRoomCard" Style="{StaticResource Card}" Margin="0,22,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <Border Style="{StaticResource IconTilePink}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Sala privada"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Só quem tem o convite vê e ouve a sala. Presença, chat, voz e imagens vão cifrados de ponta a ponta."/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource InsetCard}" Padding="14,12" Margin="0,0,0,14">
                            <DockPanel>
                                <Ellipse x:Name="PrivateDot" Width="9" Height="9" Fill="{DynamicResource TextSubtle}" VerticalAlignment="Top" Margin="2,6,12,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="PrivateStatus" Style="{StaticResource Body}" FontSize="13.5" TextWrapping="Wrap" Text="Sala aberta: todo mundo da rede do Radmin vê a sala."/>
                                    <TextBlock x:Name="PrivateFingerprint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <StackPanel x:Name="PrivateOffPanel">
                            <CheckBox x:Name="PrivateApprovedOnlyNew" Style="{StaticResource Switch}" Margin="0,0,0,10"
                                      Content="Só participa quem eu aprovar (mesmo com o convite)"/>
                            <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="16,0" Margin="0,0,0,16"
                                    Content="Criar sala privada" Click="PrivateCreate_Click"/>
                            <TextBlock Style="{StaticResource Label}" Text="Recebeu um convite?"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Entrar" MinHeight="34" Padding="16,0" Margin="8,0,0,0" Click="PrivateJoin_Click"/>
                                <TextBox x:Name="PrivateInviteBox" AutomationProperties.Name="Código do convite" ToolTip="Cole aqui o código SF1-… que você recebeu"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="PrivateOnPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Label}" Text="Convite"/>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Copiar" MinHeight="34" Padding="14,0" Margin="8,0,0,0" Click="PrivateCopy_Click"/>
                                <TextBox x:Name="PrivateCodeBox" IsReadOnly="True" FontFamily="{DynamicResource FontMono}" FontSize="12" AutomationProperties.Name="Código do convite da sala"/>
                            </DockPanel>
                            <StackPanel x:Name="PrivateOwnerPanel">
                                <CheckBox x:Name="PrivateApprovedOnlyToggle" Style="{StaticResource Switch}" Margin="0,0,0,10" Click="PrivateApprovedOnly_Click"
                                          Content="Só participa quem eu aprovar (mesmo com o convite)"/>
                                <TextBlock x:Name="PrivatePendingTitle" Style="{StaticResource Label}" Text="Pedindo para entrar"/>
                                <StackPanel x:Name="PrivatePendingList" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource Label}" Text="Na sala agora"/>
                                <StackPanel x:Name="PrivateMembersList" Margin="0,0,0,10"/>
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <Button x:Name="PrivateRotateButton" Content="Trocar a chave" MinHeight="34" Padding="14,0" Margin="0,0,8,8" Click="PrivateRotate_Click"
                                        ToolTip="Todo mundo que está na sala agora recebe a chave nova; o convite antigo deixa de valer."/>
                                <Button Style="{StaticResource GhostButton}" Content="Sair da sala privada" MinHeight="34" Padding="12,0" Margin="0,0,8,8" Click="PrivateLeave_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock x:Name="BlockedTitle" Style="{StaticResource Label}" Text="Pessoas bloqueadas" Margin="0,8,0,6" Visibility="Collapsed"/>
                        <StackPanel x:Name="BlockedList"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="A sala privada não muda quem assiste às transmissões (isso continua pelo PIN e pela aprovação em Transmissão). Quem tem o convite consegue ler a sala até ser removido: Remover troca a chave para todo mundo que está na sala, e quem estiver offline nessa hora precisa de um convite novo. Quem está na 1.3 ou mais antiga não entra em sala privada."/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <!-- ═════════════ Servidor (1.4.1) ═════════════ -->
            <Grid x:Name="ServerColumns" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Servidor ScreenFlow -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,18">
                            <Border Style="{StaticResource IconTileCyan}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE753;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Servidor ScreenFlow"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Em vez de cada PC falar com cada um, todo mundo entra num PC servidor: o chat, a voz e as transmissões passam por ele."/>
                            </StackPanel>
                        </DockPanel>
                        <RadioButton x:Name="RoleNone" GroupName="serverRole" Style="{StaticResource ModeCard}" Margin="0,0,0,10" Checked="Role_Checked">
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock FontWeight="SemiBold" FontSize="14.5" Text="Sem servidor"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Como sempre: a sala e as transmissões vão direto de um PC para o outro, pelo Radmin VPN ou pelo Tailscale."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RoleJoin" GroupName="serverRole" Style="{StaticResource ModeCard}" Margin="0,0,0,10" Checked="Role_Checked">
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock FontWeight="SemiBold" FontSize="14.5" Text="Entrar num servidor"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="O chat, a voz e as transmissões passam pelo PC servidor. Quem transmite manda uma cópia só, e quem assiste recebe do servidor."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RoleHost" GroupName="serverRole" Style="{StaticResource ModeCard}" Checked="Role_Checked">
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock FontWeight="SemiBold" FontSize="14.5" Text="Este PC é o servidor"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="O servidor roda dentro do ScreenFlow, neste PC (ele precisa ficar ligado). Os outros entram com o endereço deste PC no Tailscale ou no Radmin VPN."/>
                            </StackPanel>
                        </RadioButton>

                        <StackPanel x:Name="JoinPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Label}" Text="Endereço do servidor"/>
                            <TextBox x:Name="ServerAddressBox" MaxLength="255" FontFamily="{DynamicResource FontMono}"
                                     Tag="100.64.1.2, 26.1.2.3 ou o nome do PC no Tailscale"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,14" TextWrapping="Wrap"
                                       Text="O IP do PC servidor no Tailscale (100.x) ou no Radmin VPN (26.x), ou o nome dele no Tailscale. Se o servidor usa outra porta, coloque depois de dois pontos (100.64.1.2:47810)."/>
                            <TextBlock Style="{StaticResource Label}" Text="Senha do servidor"/>
                            <PasswordBox x:Name="ServerPasswordBox" MaxLength="128" AutomationProperties.Name="Senha do servidor"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="Deixe vazio se o servidor não tem senha."/>
                        </StackPanel>

                        <StackPanel x:Name="HostPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Label}" Text="Nome do servidor"/>
                            <TextBox x:Name="HostedNameBox" MaxLength="40" Margin="{DynamicResource FieldGap}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Senha do servidor (opcional)"/>
                            <TextBox x:Name="HostedPasswordBox" MaxLength="128" Tag="Sem senha"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Com senha, só entra quem souber. Pelo servidor, a senha dele vale no lugar do PIN e da aprovação de quem transmite."/>
                        </StackPanel>

                        <CheckBox x:Name="TransmitViaServerToggle" Style="{StaticResource Switch}" Margin="0,18,0,0" Visibility="Collapsed"
                                  Content="Quando eu transmitir, mandar também pelo servidor (uma cópia só, e quem está nele assiste por lá)"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap" Text="Vale quando você salvar."/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- Como está -->
                    <Border Style="{StaticResource Card}" Margin="{DynamicResource StackGap}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Procurar o servidor de novo"
                                        Click="ServerRetry_Click" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource IconTileBlue}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Heading}" Text="Como está"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="O servidor em uso e as redes deste PC."/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource InsetCard}" Padding="14,12">
                                <DockPanel>
                                    <Ellipse x:Name="ServerDot" Width="9" Height="9" Fill="{DynamicResource TextSubtle}" VerticalAlignment="Top" Margin="2,6,12,0"/>
                                    <TextBlock x:Name="ServerStatusText" Style="{StaticResource Body}" FontSize="13.5" TextWrapping="Wrap" Text="Sem servidor."/>
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="HostedDetails" Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Margin="2,12,0,0" Visibility="Collapsed"/>
                            <TextBlock Style="{StaticResource Label}" Text="Redes deste PC" Margin="0,18,0,7"/>
                            <ItemsControl x:Name="AddressList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetCard}" Margin="0,0,0,6" Padding="12,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copiar o endereço"
                                                        Click="CopyAddress_Click" Tag="{Binding Address}"/>
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Network, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Address, Mode=OneWay}"
                                                         FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextMuted}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AddressHint" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Tailscale -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border Style="{StaticResource IconTileViolet}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE968;"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Heading}" Text="Tailscale"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="Junta os PCs numa rede só, até pela internet, sem abrir portas no roteador. Cada pessoa entra na própria conta."/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="TailscaleText" Style="{StaticResource Body}" FontSize="13.5" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="TailscaleProgress" Height="6" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="TailscaleButton" Content="Instalar o Tailscale" MinHeight="34" Padding="14,0" Margin="0,0,8,8" Click="Tailscale_Click"/>
                                <Button x:Name="TailscaleOpenButton" Style="{StaticResource GhostButton}" Content="Abrir o Tailscale" MinHeight="34" Padding="12,0" Margin="0,0,8,8"
                                        Click="TailscaleOpen_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Guia do servidor" MinHeight="34" Padding="12,0" Margin="0,0,0,8" Click="ServerGuide_Click"
                                        ToolTip="Como montar um PC servidor (Linux ou Windows) com o programa do servidor"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═════════════ Rede e diagnóstico ═════════════ -->
            <Grid x:Name="NetworkColumns" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rede -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <Border Style="{StaticResource IconTileBlue}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE968;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Rede e firewall"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Portas usadas pelo ScreenFlow na rede (Radmin VPN ou Tailscale)."/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="{DynamicResource FieldGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Mídia (UDP)" TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="MediaPortBox" MaxLength="5" FontFamily="{DynamicResource FontMono}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Controle (TCP)" TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="ControlPortBox" MaxLength="5" FontFamily="{DynamicResource FontMono}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource Label}" Text="Descoberta (UDP)" TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="DiscoveryPortBox" MaxLength="5" FontFamily="{DynamicResource FontMono}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6" ToolTip="Os arquivos do chat vão direto de um PC para o outro por esta porta.">
                                <TextBlock Style="{StaticResource Label}" Text="Arquivos (TCP)" TextTrimming="CharacterEllipsis"/>
                                <TextBox x:Name="FilePortBox" MaxLength="5" FontFamily="{DynamicResource FontMono}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="{DynamicResource FieldGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Seu upload (Mbps)"/>
                                <TextBox x:Name="UploadBox" Tag="Desconhecido" ToolTip="Medido pelo botão 'Testar banda' na Transmissão. Usado para dividir a qualidade entre quem assiste."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="Máximo de pessoas"/>
                                <TextBox x:Name="MaxViewersBox" MaxLength="2"/>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="FirewallCard" Style="{StaticResource InsetCard}" Padding="14,12">
                            <DockPanel>
                                <Button x:Name="FirewallButton" DockPanel.Dock="Right" Content="Liberar portas" MinHeight="36" Padding="14,0" Margin="12,0,0,0" Click="Firewall_Click"/>
                                <Ellipse x:Name="FirewallDot" Width="9" Height="9" Fill="{DynamicResource TextSubtle}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <TextBlock x:Name="FirewallText" Style="{StaticResource Body}" FontSize="13.5" VerticalAlignment="Center" TextWrapping="Wrap" Text="Conferindo o firewall…"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Diagnóstico -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Detectar o hardware de novo" Click="RefreshDiagnostics_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copiar o diagnóstico" Click="CopyDiagnostics_Click" Margin="4,0,0,0"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Abrir a pasta de logs" Click="OpenLogs_Click" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Border Style="{StaticResource IconTileAmber}" Width="38" Height="38" CornerRadius="11" TextElement.FontSize="16">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Heading}" Text="Diagnóstico"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Mande isto se algo não funcionar."/>
                            </StackPanel>
                        </DockPanel>
                        <TextBox x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                 Height="300" VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" Padding="12,10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
