<UserControl x:Class="ScreenFlow.App.Pages.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenFlow.App.Controls">
    <UserControl.Resources>
        <!-- Título de cada grupo de canais (CANAIS DE TEXTO, CANAIS DE VOZ) -->
        <Style x:Key="ChannelCategory" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSubtle}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- O + de criar canal -->
        <Style x:Key="ChannelAddButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Content" Value="&#xE710;"/>
        </Style>

        <!-- (1.5.0) O + de adicionar servidor, no fim da lista de servidores -->
        <Style x:Key="ServerAddButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Success}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="23" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="16" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="CornerRadius" Value="15"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Success}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Success}"/>
                                <Setter Property="Foreground" Value="#03231A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- (1.5.0) Mensagens diretas, no topo da lista de servidores (a marca e o número de não lidas como num servidor) -->
        <Style x:Key="DirectRailButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Marker" Width="4" Height="8" CornerRadius="0,4,4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Text}" Opacity="0"/>
                            <Grid Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="Icon" CornerRadius="23" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="18" Foreground="{DynamicResource AccentText}"/>
                                </Border>
                                <Border x:Name="Badge" Style="{StaticResource CountBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-7,0" Height="21"
                                        CornerRadius="10.5" BorderThickness="2.5" BorderBrush="{DynamicResource Surface}">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Icon" Property="CornerRadius" Value="15"/>
                                <Setter TargetName="Marker" Property="Height" Value="20"/>
                                <Setter TargetName="Marker" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="CornerRadius" Value="15"/>
                                <Setter TargetName="Icon" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                <Setter TargetName="Icon" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                <Setter TargetName="Marker" Property="Height" Value="36"/>
                                <Setter TargetName="Marker" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de ícone que fica marcado (mostrar quem está na rede) -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontIcons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alguém num canal de voz (anel verde = falando; botão direito = volume só para você) -->
        <DataTemplate x:Key="MemberTemplate">
            <Border x:Name="Member" CornerRadius="7" Padding="6,3" Margin="0,1" Background="Transparent" ToolTip="{Binding Hint}"
                    MouseRightButtonUp="Member_MouseRightButtonUp">
                <DockPanel>
                    <Grid Width="24" Height="24">
                        <Ellipse x:Name="Ring" Margin="-3" Stroke="{DynamicResource Success}" StrokeThickness="2" Opacity="0"/>
                        <controls:AvatarView Colors="{Binding Avatar}" Initial="{Binding Initial}" Photo="{Binding Photo}" TextElement.FontSize="10.5"/>
                    </Grid>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE993;" FontSize="12" Margin="4,0,0,0" Foreground="{DynamicResource TextSubtle}"
                                   Visibility="{Binding VolumeChanged, Converter={StaticResource BoolToVisibility}}"/>
                        <Grid Width="16" Height="16" Margin="4,0,0,0" Visibility="{Binding LocallyMuted, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="12" Foreground="{DynamicResource Danger}"/>
                            <Path Data="M2.5,2.5 L13.5,13.5" Stroke="{DynamicResource Danger}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <Grid Width="16" Height="16" Margin="4,0,0,0" Visibility="{Binding ShowMuted, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="12" Foreground="{DynamicResource Danger}"/>
                            <Path Data="M2.5,2.5 L13.5,13.5" Stroke="{DynamicResource Danger}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <Grid Width="16" Height="16" Margin="4,0,0,0" Visibility="{Binding Deafened, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;" FontSize="12" Foreground="{DynamicResource Danger}"/>
                            <Path Data="M2.5,2.5 L13.5,13.5" Stroke="{DynamicResource Danger}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="MemberName" Text="{Binding DisplayName}" Margin="9,0,4,0" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Member" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Member" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Speaking}" Value="True">
                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                    <Setter TargetName="MemberName" Property="Foreground" Value="{DynamicResource Text}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Como no Discord: os servidores na barra da esquerda (1.5.0), os canais do servidor aberto, a conversa do canal no
         meio e quem está nele à direita. Só a conversa rola; a caixa de escrever fica sempre embaixo. -->
    <Grid Margin="24,18,24,24" MaxWidth="1680">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────────── Servidores: a sala da rede e os servidores por rede do Radmin (1.5.0) ───────────── -->
        <Border x:Name="ServerRail" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="0" Width="72">
            <DockPanel>
                <Button x:Name="AddServerButton" DockPanel.Dock="Bottom" Style="{StaticResource ServerAddButton}" Margin="0,6,0,14"
                        ToolTip="Adicionar um servidor (de uma rede do Radmin, por convite ou um novo)" Click="AddServer_Click"/>
                <Border DockPanel.Dock="Bottom" Height="2" Width="30" CornerRadius="1" Background="{DynamicResource Divider}" Margin="0,4,0,4"/>
                <ToggleButton x:Name="DirectButton" DockPanel.Dock="Top" Style="{StaticResource DirectRailButton}" Margin="0,10,0,0"
                              ToolTip="Mensagens diretas: conversas só entre você e outra pessoa, cifradas" Click="DirectButton_Click"/>
                <Border DockPanel.Dock="Top" Height="2" Width="30" CornerRadius="1" Background="{DynamicResource Divider}" Margin="0,4,0,0"/>
                <ScrollViewer Style="{StaticResource PageScroll}" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="ServerList" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid x:Name="Item" Height="56" Background="Transparent" Cursor="Hand" ToolTip="{Binding Hint}"
                                          MouseLeftButtonUp="Server_MouseLeftButtonUp" MouseRightButtonUp="Server_MouseRightButtonUp">
                                        <!-- A marca à esquerda: pequena com mensagens novas, grande no servidor aberto -->
                                        <Border x:Name="Marker" Width="4" Height="8" CornerRadius="0,4,4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource Text}" Opacity="0"/>
                                        <Grid Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border x:Name="Icon" CornerRadius="23" Background="{Binding Colors.Background}">
                                                <TextBlock Text="{Binding Initials}" Foreground="{Binding Colors.Foreground}" FontWeight="Bold" FontSize="15"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="NetworkIcon" CornerRadius="23" Background="{DynamicResource AccentGradient}"
                                                    Visibility="{Binding IsNetworkRoom, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F2;" FontSize="19" Foreground="{DynamicResource OnAccent}"/>
                                            </Border>
                                            <!-- Você está na voz deste servidor -->
                                            <Border Width="19" Height="19" CornerRadius="9.5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-3"
                                                    Background="{DynamicResource Success}" BorderThickness="2.5" BorderBrush="{DynamicResource Surface}" IsHitTestVisible="False"
                                                    Visibility="{Binding InVoice, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="8.5" Foreground="#03231A"/>
                                            </Border>
                                            <!-- Conexão: verde com gente, âmbar procurando, cinza desligado -->
                                            <Border x:Name="Dot" Width="15" Height="15" CornerRadius="7.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                    BorderThickness="3" BorderBrush="{DynamicResource Surface}" Background="{DynamicResource Success}" IsHitTestVisible="False"/>
                                            <!-- Mensagens novas -->
                                            <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-7,0" Height="21"
                                                    CornerRadius="10.5" BorderThickness="2.5" BorderBrush="{DynamicResource Surface}"
                                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding UnreadText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <Border Height="2" Width="30" CornerRadius="1" Background="{DynamicResource Divider}" Margin="0,4,0,6"
                                            Visibility="{Binding IsNetworkRoom, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Icon" Property="CornerRadius" Value="15"/>
                                        <Setter TargetName="NetworkIcon" Property="CornerRadius" Value="15"/>
                                        <Setter TargetName="Marker" Property="Height" Value="20"/>
                                        <Setter TargetName="Marker" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                        <Setter TargetName="Marker" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Icon" Property="CornerRadius" Value="15"/>
                                        <Setter TargetName="NetworkIcon" Property="CornerRadius" Value="15"/>
                                        <Setter TargetName="Marker" Property="Height" Value="36"/>
                                        <Setter TargetName="Marker" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Amber}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource TextSubtle}"/>
                                        <Setter TargetName="Icon" Property="Opacity" Value="0.45"/>
                                        <Setter TargetName="NetworkIcon" Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="ContentGrid" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ChannelsColumn" Width="236"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PeopleGap" Width="14"/>
                <ColumnDefinition x:Name="PeopleColumn" Width="256"/>
            </Grid.ColumnDefinitions>

            <!-- ───────────── Canais ───────────── -->
            <Border x:Name="ChannelsCard" Style="{StaticResource Card}" Margin="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="16,14,12,13">
                        <Button x:Name="ServerMenuButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;" Width="30" Height="30"
                                MinHeight="30" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Opções do servidor" Visibility="Collapsed"
                                Click="ServerMenu_Click"/>
                        <Grid Width="34" Height="34" VerticalAlignment="Center">
                            <Border x:Name="NetworkTile" Style="{StaticResource IconTileCyan}" Width="34" Height="34" CornerRadius="10" TextElement.FontSize="15">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F2;"/>
                            </Border>
                            <Border x:Name="ServerTile" CornerRadius="10" Visibility="Collapsed">
                                <TextBlock x:Name="ServerTileText" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ServerTitle" Text="Sala da rede" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RoomInfo" Style="{StaticResource Caption}" Text="Só você online" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource DividerLine}" VerticalAlignment="Bottom"/>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
                        <StackPanel Margin="8,10,8,12">
                            <DockPanel Margin="8,2,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ChannelAddButton}" ToolTip="Criar canal de texto" Click="CreateText_Click"/>
                                <TextBlock Style="{StaticResource ChannelCategory}" Text="CANAIS DE TEXTO"/>
                            </DockPanel>
                            <ItemsControl x:Name="TextChannelList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="8" Height="34" Padding="10,0,8,0" Margin="0,1" Background="Transparent" Cursor="Hand"
                                                ToolTip="{Binding Topic}" MouseLeftButtonUp="TextChannel_MouseLeftButtonUp" MouseRightButtonUp="TextChannel_MouseRightButtonUp">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource CountBadge}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding UnreadText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="Hash" Text="#" FontSize="18" Width="14" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center"
                                                           Margin="0,0,0,2"/>
                                                <TextBlock x:Name="ChannelName" Text="{Binding DisplayName}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                <Setter TargetName="ChannelName" Property="Foreground" Value="{DynamicResource Text}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                <Setter TargetName="ChannelName" Property="Foreground" Value="{DynamicResource Text}"/>
                                                <Setter TargetName="ChannelName" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter TargetName="Hash" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                <Setter TargetName="ChannelName" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                <Setter TargetName="ChannelName" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <DockPanel Margin="8,16,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ChannelAddButton}" ToolTip="Criar canal de voz" Click="CreateVoice_Click"/>
                                <TextBlock Style="{StaticResource ChannelCategory}" Text="CANAIS DE VOZ"/>
                            </DockPanel>
                            <ItemsControl x:Name="VoiceChannelList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,1,0,0">
                                            <Border x:Name="Row" CornerRadius="8" Height="34" Padding="9,0,8,0" Background="Transparent" Cursor="Hand"
                                                    ToolTip="{Binding Hint}" MouseLeftButtonUp="VoiceChannel_MouseLeftButtonUp" MouseRightButtonUp="VoiceChannel_MouseRightButtonUp">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="15" Width="16" Foreground="{DynamicResource TextSubtle}"/>
                                                    <TextBlock x:Name="ChannelName" Text="{Binding DisplayName}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Members}" Margin="22,0,0,3" Focusable="False" ItemTemplate="{StaticResource MemberTemplate}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                <Setter TargetName="ChannelName" Property="Foreground" Value="{DynamicResource Text}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding HasMembers}" Value="True">
                                                <Setter TargetName="ChannelName" Property="Foreground" Value="{DynamicResource Text}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Success}"/>
                                                <Setter TargetName="ChannelName" Property="Foreground" Value="{DynamicResource Success}"/>
                                                <Setter TargetName="ChannelName" Property="FontWeight" Value="SemiBold"/>
                                                <Setter TargetName="Row" Property="Cursor" Value="Arrow"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" Margin="10,10,8,0"
                                       Text="Clique num canal de voz para entrar. Botão direito em alguém muda o volume só para você."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ───────────── (1.5.0) Mensagens diretas: as conversas, com busca ───────────── -->
            <Border x:Name="DirectCard" Style="{StaticResource Card}" Margin="0" Padding="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="16,14,12,13">
                        <Border Style="{StaticResource IconTileViolet}" Width="34" Height="34" CornerRadius="10" TextElement.FontSize="15">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Mensagens diretas" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Cifradas só para vocês dois" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource DividerLine}" VerticalAlignment="Bottom"/>
                    <TextBox x:Name="DirectSearch" Grid.Row="1" Margin="12,12,12,4" MinHeight="36" Tag="Procurar uma conversa" TextChanged="DirectSearch_TextChanged"/>
                    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
                        <StackPanel Margin="8,6,8,12">
                            <ItemsControl x:Name="DirectList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="10" Padding="8,7" Margin="0,1" Background="Transparent" Cursor="Hand"
                                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding StatusText}"
                                                MouseLeftButtonUp="Conversation_MouseLeftButtonUp" MouseRightButtonUp="Conversation_MouseRightButtonUp">
                                            <DockPanel>
                                                <Grid Width="36" Height="36">
                                                    <controls:AvatarView Colors="{Binding Avatar}" Initial="{Binding Initial}" Photo="{Binding Photo}" TextElement.FontSize="14"/>
                                                    <Border x:Name="Dot" Width="13" Height="13" CornerRadius="6.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,-2,-2" BorderThickness="2.5" BorderBrush="{DynamicResource Surface}" Background="{DynamicResource TextSubtle}"/>
                                                </Grid>
                                                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/>
                                                    <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Right" Margin="0,3,0,0"
                                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding UnreadText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PersonName" Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock x:Name="Preview" Text="{Binding Preview}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource SurfaceHover}"/>
                                                <Setter TargetName="PersonName" Property="Foreground" Value="{DynamicResource Text}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                <Setter TargetName="PersonName" Property="Foreground" Value="{DynamicResource Text}"/>
                                                <Setter TargetName="PersonName" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding KeyChanged}" Value="True">
                                                <Setter TargetName="Preview" Property="Text" Value="A chave da pessoa mudou: confira antes"/>
                                                <Setter TargetName="Preview" Property="Foreground" Value="{DynamicResource Amber}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Surface}"/>
                                                <Setter TargetName="PersonName" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                <Setter TargetName="PersonName" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoConversations" Style="{StaticResource Muted}" FontSize="13" LineHeight="19" Margin="8,6,8,0" TextWrapping="Wrap"
                                       Text="Nenhuma conversa ainda. Para começar, passe o mouse em alguém na lista de quem está no servidor e clique no balão (ou use o botão direito)."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ───────────── Conversa do canal (dá para soltar uma imagem aqui para mandar) ───────────── -->
            <Border x:Name="ConversationCard" Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0" AllowDrop="True"
                    PreviewDragOver="Conversation_PreviewDragOver" PreviewDrop="Conversation_PreviewDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="20,12,12,11">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="SafetyPill" Style="{StaticResource Pill}" Margin="0,0,8,0" Cursor="Hand" Visibility="Collapsed"
                                    ToolTip="Só você e a pessoa leem esta conversa. Clique para ver o código de segurança."
                                    MouseLeftButtonUp="SafetyPill_MouseLeftButtonUp">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="12" Margin="0,0,7,0"/>
                                    <TextBlock Text="Cifrada de ponta a ponta"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ArchivePill" Style="{StaticResource Pill}" Margin="0,0,8,0" Cursor="Hand" Visibility="Collapsed"
                                    MouseLeftButtonUp="ArchivePill_MouseLeftButtonUp">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="12" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="ArchiveText" Text="Guardado na pasta"/>
                                </StackPanel>
                            </Border>
                            <ToggleButton x:Name="PeopleToggle" Style="{StaticResource IconToggle}" Content="&#xE716;" ToolTip="Mostrar ou esconder quem está na rede"
                                          Click="PeopleToggle_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ChannelHash" Text="#" FontSize="24" Foreground="{DynamicResource TextSubtle}" VerticalAlignment="Center" Margin="2,0,12,3"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ChannelTitle" Text="geral" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ChannelTopic" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource DividerLine}" VerticalAlignment="Bottom"/>

                    <ScrollViewer x:Name="MessageScroll" Grid.Row="1" Style="{StaticResource PageScroll}" PreviewMouseWheel="MessageScroll_PreviewMouseWheel"
                                  ScrollChanged="MessageScroll_ScrollChanged">
                        <ItemsControl x:Name="MessageList" Margin="0,8,0,10" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Row" Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Hover" Grid.ColumnSpan="2" Background="Transparent"/>
                                        <!-- Foto (só na primeira de um grupo); nas seguintes, a hora aparece ao passar o mouse -->
                                        <controls:AvatarView x:Name="AvatarBox" Width="38" Height="38" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,14,0"
                                                             Colors="{Binding Avatar}" Initial="{Binding Initial}" Photo="{Binding Photo}" TextElement.FontSize="15"/>
                                        <TextBlock x:Name="SideTime" Text="{Binding TimeText}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"
                                                   VerticalAlignment="Top" Margin="0,3,14,0" Visibility="Hidden"/>
                                        <StackPanel Grid.Column="1" Margin="0,0,22,0">
                                            <StackPanel x:Name="Header" Orientation="Horizontal" Margin="0,0,0,1">
                                                <TextBlock x:Name="AuthorName" Text="{Binding AuthorText}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding TimeText}" ToolTip="{Binding FullTimeText}" Style="{StaticResource Caption}" Margin="9,1,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" Margin="0,0,0,2"
                                                     Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"/>
                                            <!-- Imagem: o espaço dela já fica reservado enquanto baixa -->
                                            <Grid x:Name="PictureBox" Width="{Binding PictureWidth}" Height="{Binding PictureHeight}" HorizontalAlignment="Left" Margin="0,4,0,6"
                                                  Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}" Cursor="Hand" Tag="{Binding}"
                                                  ToolTip="{Binding ImageInfo}" MouseLeftButtonUp="Picture_MouseLeftButtonUp">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Abrir no visualizador" Click="OpenPicture_Click"/>
                                                        <MenuItem Header="Salvar como…" Click="SavePicture_Click"/>
                                                        <MenuItem Header="Copiar a imagem" Click="CopyPicture_Click"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Border CornerRadius="12" Background="{DynamicResource SurfaceSunken}" BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                                                <Border CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <!-- (1.5.0) Prévia de um vídeo: o botão de tocar e a duração -->
                                                <Grid IsHitTestVisible="False" Visibility="{Binding IsVideoPreview, Converter={StaticResource BoolToVisibility}}">
                                                    <Border Width="54" Height="54" CornerRadius="27" Background="#A6000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="20" Foreground="White" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                    </Border>
                                                    <Border CornerRadius="6" Background="#A6000000" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                                        <TextBlock Text="{Binding VideoDuration}" Foreground="White" FontSize="11.5"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel x:Name="PictureLoading" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Visibility="{Binding ImageLoading, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextSubtle}"/>
                                                    <TextBlock Style="{StaticResource Caption}" Text="Baixando a imagem…" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                                            Visibility="{Binding ImageFailed, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource Caption}" Text="A imagem não chegou." HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="Tentar de novo" Margin="0,8,0,0" HorizontalAlignment="Center"
                                                            Tag="{Binding}" Click="RetryPicture_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- (1.5.0) Arquivo anexado: fica no PC de quem mandou e vem direto de lá, conferido -->
                                            <ContentControl Content="{Binding Transfer}" HorizontalAlignment="Left" Margin="0,2,0,6" Focusable="False"
                                                            Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource InsetCard}" Padding="12,11" MinWidth="300" MaxWidth="440">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Mostrar na pasta" Click="FileFolder_Click"
                                                                              Visibility="{Binding CanShowFolder, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <MenuItem Header="Parar de compartilhar" Click="FileStopSharing_Click"
                                                                              Visibility="{Binding CanStopSharing, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <MenuItem Header="Copiar o nome" Click="FileCopyName_Click"/>
                                                                    <MenuItem Header="Copiar o SHA-256" Click="FileCopyHash_Click"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="42" Height="42" CornerRadius="11" Margin="0,0,12,0">
                                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                        <Button Style="{StaticResource IconButton}" Content="&#xE896;" Width="34" Height="34" MinHeight="34" Margin="4,0,0,0"
                                                                                ToolTip="Baixar (você escolhe a pasta)" Click="FileDownload_Click"
                                                                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <Button Style="{StaticResource IconButton}" Content="&#xE769;" Width="34" Height="34" MinHeight="34" Margin="4,0,0,0"
                                                                                ToolTip="Pausar (continua depois de onde parou)" Click="FilePause_Click"
                                                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" Width="34" Height="34" MinHeight="34" Margin="4,0,0,0"
                                                                                ToolTip="Continuar de onde parou" Click="FileResume_Click"
                                                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Width="34" Height="34" MinHeight="34" Margin="4,0,0,0"
                                                                                ToolTip="Abrir" Click="FileOpen_Click"
                                                                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" Width="34" Height="34" MinHeight="34" Margin="4,0,0,0"
                                                                                ToolTip="Mostrar na pasta" Click="FileFolder_Click"
                                                                                Visibility="{Binding CanShowFolder, Converter={StaticResource BoolToVisibility}}"/>
                                                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="34" Height="34" MinHeight="34" Margin="4,0,0,0"
                                                                                ToolTip="Cancelar (apaga o que já baixou)" Click="FileCancel_Click"
                                                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </StackPanel>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                                                                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" ToolTip="O SHA-256 bateu: chegou igual ao original."
                                                                                        Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisibility}}">
                                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="10.5" Foreground="{DynamicResource Success}"
                                                                                           VerticalAlignment="Center" Margin="0,1,4,0"/>
                                                                                <TextBlock Style="{StaticResource Caption}" Text="conferido" Foreground="{DynamicResource Success}"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,0"
                                                                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}"/>
                                                                <TextBlock x:Name="StateLine" Style="{StaticResource Caption}" Text="{Binding StateText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                                           Visibility="{Binding HasStateText, Converter={StaticResource BoolToVisibility}}"/>
                                                                <DockPanel Margin="0,8,0,0" Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource Amber}"
                                                                               VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding WarningText}" Foreground="{DynamicResource Amber}" TextWrapping="Wrap"/>
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarningState}" Value="True">
                                                                <Setter TargetName="StateLine" Property="Foreground" Value="{DynamicResource Amber}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                            <!-- (1.5.0) Mensagem direta sua: esperando, enviada ou entregue -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" ToolTip="{Binding DeliveryHint}"
                                                        Visibility="{Binding ShowDelivery, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding DeliveryGlyph}" FontSize="11" Foreground="{DynamicResource TextSubtle}"
                                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource Caption}" FontSize="11.5" Text="{Binding DeliveryText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ShowHeader}" Value="True">
                                            <Setter TargetName="Row" Property="Margin" Value="0,14,0,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowHeader}" Value="False">
                                            <Setter TargetName="AvatarBox" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter TargetName="AuthorName" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowHeader}" Value="False"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="SideTime" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Canal vazio -->
                    <StackPanel x:Name="NoMessages" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Style="{StaticResource IconTileCyan}" HorizontalAlignment="Center" Width="56" Height="56" CornerRadius="16" TextElement.FontSize="24">
                            <TextBlock x:Name="EmptyGlyph" Text="#" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="Ninguém escreveu nada ainda" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="380" HorizontalAlignment="Center"
                                   Text="Mande um oi: a mensagem vai para todo mundo que está com o ScreenFlow aberto na sua rede."/>
                    </StackPanel>

                    <!-- Novas mensagens abaixo (quando você rolou para cima) -->
                    <Button x:Name="JumpButton" Grid.Row="1" Style="{StaticResource ChipButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                            Visibility="Collapsed" Click="Jump_Click" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource AccentBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" FontSize="11" Margin="0,0,8,0"/>
                            <TextBlock Text="Mensagens novas"/>
                        </StackPanel>
                    </Button>

                    <!-- Escrever -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="16,12,16,10">
                        <StackPanel>
                            <!-- (1.5.0) A pessoa da conversa apareceu com outra chave -->
                            <Border x:Name="KeyBanner" Style="{StaticResource InsetCard}" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource AmberSoft}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" Foreground="{DynamicResource Amber}"
                                               VerticalAlignment="Top" Margin="0,1,12,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="KeyBannerTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="KeyBannerText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Aceitar a chave nova" Style="{StaticResource PrimaryButton}" MinHeight="32" Height="32" Padding="12,0" FontSize="12.5"
                                                    Margin="0,0,8,0" Click="AcceptKey_Click"/>
                                            <Button Content="Manter a antiga" MinHeight="32" Height="32" Padding="12,0" FontSize="12.5" Click="KeepKey_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- Imagem anexada, antes de mandar -->
                            <Border x:Name="AttachmentPanel" Style="{StaticResource InsetCard}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Tirar a imagem"
                                            VerticalAlignment="Center" Click="RemoveAttachment_Click"/>
                                    <Border Width="64" Height="64" CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background>
                                            <ImageBrush x:Name="AttachmentPreview" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="Imagem pronta para mandar" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AttachmentInfo" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <!-- (1.5.0) Arquivos anexados, antes de mandar (o SHA-256 e a prévia ficam prontos aqui) -->
                            <ItemsControl x:Name="PendingFilesList" Margin="0,0,0,2" Focusable="False" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InsetCard}" Padding="8" Margin="0,0,8,8" Width="252" ToolTip="{Binding Path}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28" MinHeight="28"
                                                        FontSize="10" ToolTip="Tirar" VerticalAlignment="Center" Click="RemovePendingFile_Click"/>
                                                <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,10,0">
                                                    <Border Style="{StaticResource IconTile}" Width="40" Height="40" CornerRadius="10">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="10" BorderBrush="{DynamicResource Border}" BorderThickness="1" RenderOptions.BitmapScalingMode="HighQuality"
                                                            Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="PendingStatus" Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,4,0,0"
                                                                 Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDangerous}" Value="True">
                                                <Setter TargetName="PendingStatus" Property="Foreground" Value="{DynamicResource Amber}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter TargetName="PendingStatus" Property="Foreground" Value="{DynamicResource Amber}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel>
                                <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="46" MinHeight="44" Height="44" Padding="0"
                                        Margin="10,0,0,0" VerticalAlignment="Bottom" ToolTip="Enviar (Enter)" Click="Send_Click">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="16"/>
                                </Button>
                                <Button x:Name="AttachButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE723;" Width="44" Height="44"
                                        Margin="0,0,10,0" VerticalAlignment="Bottom" BorderBrush="{DynamicResource BorderStrong}" Background="{DynamicResource SurfaceRaised}"
                                        ToolTip="Anexar arquivos (fotos, vídeos, qualquer arquivo até 4 GB; ou arraste para cá, ou cole com Ctrl+V)" Click="Attach_Click"/>
                                <TextBox x:Name="Composer" Tag="Conversar em #geral" MinHeight="44" MaxHeight="132" Padding="14,11" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="500" VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="Composer_PreviewKeyDown" TextChanged="Composer_TextChanged"/>
                            </DockPanel>
                            <DockPanel Margin="2,7,2,0">
                                <TextBlock x:Name="CounterText" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="ComposerHint" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Text="Enter envia · Shift+Enter pula linha · Ctrl+V cola uma imagem · arraste arquivos para cá"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ───────────── Quem está na rede ───────────── -->
            <Border x:Name="PeopleCard" Grid.Column="4" Style="{StaticResource Card}" Margin="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="18,17,14,15">
                        <Border x:Name="OnlinePill" DockPanel.Dock="Right" Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OnlineText" Text="1 online"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PeopleTitle" Text="Na rede" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Style="{StaticResource DividerLine}" VerticalAlignment="Bottom"/>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
                        <StackPanel Margin="8,10,8,6">
                            <!-- Você -->
                            <DockPanel Margin="8,6,8,10">
                                <controls:AvatarView x:Name="SelfAvatar" Width="36" Height="36" TextElement.FontSize="14" Cursor="Hand"
                                                     ToolTip="Trocar seu nome e sua foto" MouseLeftButtonUp="SelfAvatar_MouseLeftButtonUp"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelfName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SelfStatus" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl x:Name="PeopleList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="12" Padding="8,7" Margin="0,0,0,2" Background="Transparent"
                                                MouseRightButtonUp="Person_MouseRightButtonUp">
                                            <DockPanel>
                                                <Grid Width="36" Height="36">
                                                    <controls:AvatarView Colors="{Binding Avatar}" Initial="{Binding Initial}" Photo="{Binding Photo}" TextElement.FontSize="14"/>
                                                    <!-- Bolinha de ao vivo / online -->
                                                    <Border x:Name="StateDot" Width="13" Height="13" CornerRadius="6.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,-2,-2" BorderThickness="2.5" BorderBrush="{DynamicResource Surface}" Background="{DynamicResource Success}"/>
                                                </Grid>
                                                <!-- (1.5.0) Mandar mensagem direta (aparece ao passar o mouse) -->
                                                <Button x:Name="MessageButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BD;" Width="32" Height="32"
                                                        MinHeight="32" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Mandar mensagem direta"
                                                        Tag="{Binding}" Click="MessagePerson_Click" Visibility="Collapsed"/>
                                                <Button x:Name="WatchButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinHeight="32" Height="32" Padding="12,0"
                                                        FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" Tag="{Binding}" Click="Watch_Click"
                                                        Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding ActionText}"/>
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="Status" Text="{Binding StatusText}" ToolTip="{Binding StatusText}" Style="{StaticResource Caption}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                <Setter TargetName="StateDot" Property="BorderBrush" Value="{DynamicResource SurfaceHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                <Setter TargetName="StateDot" Property="Background" Value="{DynamicResource Live}"/>
                                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Pink}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True"/>
                                                    <Condition Binding="{Binding CanMessage}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="MessageButton" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="NoPeople" Margin="8,4,8,10">
                                <TextBlock x:Name="NoPeopleText" Style="{StaticResource Muted}" FontSize="13" LineHeight="19"
                                           Text="Ninguém da rede apareceu ainda. Quem abrir o ScreenFlow 1.1 ou mais novo na mesma rede do Radmin aparece aqui sozinho."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Adicionar pelo IP -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                        <StackPanel>
                            <TextBlock x:Name="PeerHint" Style="{StaticResource Caption}" Text="Não está vendo alguém? Adicione pelo IP do Radmin." Margin="0,0,0,8"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8FA;" ToolTip="Adicionar" Margin="8,0,0,0"
                                        BorderBrush="{DynamicResource BorderStrong}" Background="{DynamicResource SurfaceRaised}" Click="AddPeer_Click"/>
                                <TextBox x:Name="PeerBox" Tag="26.x.x.x" FontFamily="{DynamicResource FontMono}" MinHeight="38" KeyDown="PeerBox_KeyDown"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ───────────── (1.5.0) Quem é a pessoa da conversa privada ───────────── -->
            <Border x:Name="DirectProfileCard" Grid.Column="4" Style="{StaticResource Card}" Margin="0" Padding="0" Visibility="Collapsed">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel Margin="20,24,20,20">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <controls:AvatarView x:Name="ProfileAvatar" TextElement.FontSize="26"/>
                            <Border x:Name="ProfileDot" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    BorderThickness="3.5" BorderBrush="{DynamicResource Surface}" Background="{DynamicResource TextSubtle}"/>
                        </Grid>
                        <TextBlock x:Name="ProfileName" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,3" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ProfileStatus" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource InsetCard}" Padding="14,12" Margin="0,20,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Foreground="{DynamicResource Success}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Código de segurança" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="ProfileCode" FontFamily="{DynamicResource FontMono}" FontSize="15" Margin="0,9,0,7" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="17"
                                           Text="Confira com a pessoa por voz ou pessoalmente: se o código for igual nos dois PCs, ninguém está no meio da conversa."/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="17" Margin="2,14,2,0"
                                   Text="As mensagens vão cifradas só para a pessoa, por qualquer servidor em que vocês dois estejam, e ficam guardadas cifradas neste PC."/>
                        <Button x:Name="ProfileRemove" Style="{StaticResource GhostButton}" Content="Apagar a conversa deste PC" Margin="0,16,0,0" HorizontalAlignment="Center"
                                Click="RemoveConversation_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Sala desligada (porta ocupada) ou (1.5.0) servidor desconectado ou sem a chave -->
        <Border x:Name="ErrorPanel" Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="28" VerticalAlignment="Top" Visibility="Collapsed"
                BorderBrush="{DynamicResource AmberSoft}">
            <DockPanel>
                <Border Style="{StaticResource IconTileAmber}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;"/>
                </Border>
                <StackPanel Margin="18,0,0,0">
                    <TextBlock x:Name="ErrorTitle" Style="{StaticResource Heading}" Text="A sala da rede está desligada" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ErrorActions" Orientation="Horizontal" Margin="0,18,0,0" Visibility="Collapsed">
                        <Button x:Name="ErrorConnectButton" Style="{StaticResource PrimaryButton}" Content="Conectar" MinWidth="120" Margin="0,0,10,0" Click="ErrorConnect_Click"/>
                        <Button x:Name="ErrorEditButton" Content="Editar o servidor" Margin="0,0,10,0" Click="ErrorEdit_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Remover da lista" Click="ErrorRemove_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
