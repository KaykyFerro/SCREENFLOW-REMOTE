<UserControl x:Class="ScreenFlow.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="{DynamicResource ContentMaxWidth}" Margin="32" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40">
            <TextBlock Style="{StaticResource Title}" HorizontalAlignment="Center" Text="O que você quer fazer?"/>
            <TextBlock Style="{StaticResource Subtitle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"
                       Text="Compartilhe a tela e o áudio do seu PC pela rede do Radmin VPN, ou assista a de alguém."/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource TileButton}" Click="Transmit_Click" MinHeight="240">
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Transmitir" FontSize="26" FontWeight="Bold" Margin="0,24,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Mostre sua tela e o som do PC para quem estiver na sua rede Radmin."/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource TileButton}" Click="Watch_Click" MinHeight="240">
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Assistir" FontSize="26" FontWeight="Bold" Margin="0,24,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Digite o IP do Radmin de quem está transmitindo e pronto."/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
