<Window x:Class="ScreenFlow.App.Windows.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenFlow — Player" Width="1280" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="/Assets/screenflow.ico"
        Background="{DynamicResource VideoBackground}" Foreground="{DynamicResource VideoText}"
        FontFamily="{DynamicResource FontUi}" UseLayoutRounding="True"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove" Closing="Window_Closing">
    <Grid x:Name="Root" MouseLeftButtonDown="Root_MouseLeftButtonDown" Background="{DynamicResource VideoBackground}">
        <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" SnapsToDevicePixels="True"/>

        <!-- Estados: conectando, aguardando aprovação, reconectando, erro -->
        <Border x:Name="StateOverlay" Background="{DynamicResource VideoOverlay}" CornerRadius="{DynamicResource RadiusLg}" Padding="32,24"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <StackPanel>
                <TextBlock x:Name="StateIcon" Style="{StaticResource Icon}" FontSize="32" Text="&#xE895;" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="StateTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6" Text="Conectando…"/>
                <TextBlock x:Name="StateMessage" FontSize="14" Opacity="0.8" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="StateClose" Content="Fechar" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed" Click="Close_Click"/>
            </StackPanel>
        </Border>

        <!-- Overlay de estatísticas (F3) -->
        <Border x:Name="StatsPanel" Background="{DynamicResource VideoOverlay}" CornerRadius="{DynamicResource RadiusMd}" Padding="14,10"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Visibility="Collapsed">
            <TextBlock x:Name="StatsText" FontFamily="{DynamicResource FontMono}" FontSize="12" LineHeight="18"/>
        </Border>

        <!-- Barra de controles: some sozinha com o mouse parado -->
        <Border x:Name="ControlBar" Background="{DynamicResource VideoOverlay}" CornerRadius="{DynamicResource RadiusLg}" Padding="10,6"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource VideoText}" Content="&#xE767;" ToolTip="Mudo (M)" Click="Mute_Click"/>
                <Slider x:Name="VolumeSlider" Width="140" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="4,0,12,0" ValueChanged="Volume_Changed"/>
                <Button x:Name="StatsButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource VideoText}" Content="&#xE9D9;" ToolTip="Estatísticas (F3)" Click="Stats_Click"/>
                <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource VideoText}" Content="&#xE740;" ToolTip="Tela cheia (F11 ou duplo clique)" Click="Fullscreen_Click"/>
                <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource Danger}" Content="&#xE711;" ToolTip="Desconectar" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
