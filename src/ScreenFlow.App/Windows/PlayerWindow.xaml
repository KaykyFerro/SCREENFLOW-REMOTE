<Window x:Class="ScreenFlow.App.Windows.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenFlow.App.Controls"
        Title="ScreenFlow" Width="1280" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="/Assets/screenflow.ico"
        Background="{DynamicResource VideoBackground}" Foreground="{DynamicResource VideoText}"
        FontFamily="{DynamicResource FontUi}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="Window_KeyDown" MouseMove="Window_MouseMove" Closing="Window_Closing">
    <!-- O player é sempre escuro, independente do tema do app. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Escolhas da janelinha de qualidade (resolução, FPS, formato da câmera) -->
            <Style x:Key="PlayerChip" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="16" Padding="13,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#26FFFFFF"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fundo das janelinhas do player (qualidade e apps do som) -->
            <Style x:Key="PlayerPopupCard" TargetType="Border">
                <Setter Property="Width" Value="372"/>
                <Setter Property="Margin" Value="16,20,16,6"/>
                <Setter Property="Background" Value="#FA101932"/>
                <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="18,14,18,16"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource VideoBackground}" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <!-- Vídeo pela CPU (quando a GPU não está disponível) -->
        <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" SnapsToDevicePixels="True" Visibility="Collapsed"/>

        <!-- Vídeo pela GPU: a superfície nativa entra aqui pelo código -->
        <Border x:Name="SurfaceHost" Visibility="Collapsed"/>

        <!-- Festa de música: sem vídeo, só o som e o visualizador -->
        <Grid x:Name="PartyView" Visibility="Collapsed">
            <Grid.Background>
                <RadialGradientBrush Center="0.15,0.1" GradientOrigin="0.15,0.1" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#3A9D84FF" Offset="0"/>
                    <GradientStop Color="#00090E1C" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.9,0.95" GradientOrigin="0.9,0.95" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#33FF5C97" Offset="0"/>
                        <GradientStop Color="#00090E1C" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Grid Margin="64,56,64,120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Background="{DynamicResource PinkSoft}" BorderBrush="#66FF5C97"
                            TextElement.Foreground="{DynamicResource Pink}" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PartyLiveDot" Width="7" Height="7" Fill="{DynamicResource Pink}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Festa de música · ao vivo"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PartyHost" FontFamily="{DynamicResource FontDisplay}" FontSize="46" FontWeight="Bold" Margin="0,18,0,6"
                               TextTrimming="CharacterEllipsis" Text="Festa de música"/>
                    <TextBlock x:Name="PartyDetail" FontSize="15" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Text="O som que toca no PC de quem transmite chega aqui em qualidade de música. Ajuste o volume na barra de baixo."/>

                    <!-- Tocando agora no PC de quem transmite (1.2.0), com voltar, pausar, pular e mudar o ponto. A largura é fixa
                         (até 660): o cartão não cresce nem encolhe quando a música muda. -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="660"/>
                        </Grid.ColumnDefinitions>
                    <Border x:Name="PartyMedia" Visibility="Collapsed" CornerRadius="18" Padding="14"
                            Background="#B3101932" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Width="76" Height="76">
                                <Border CornerRadius="13" Background="{DynamicResource BrandGradient}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="26" Foreground="{DynamicResource OnAccent}"/>
                                </Border>
                                <Border x:Name="PartyCover" CornerRadius="13" Visibility="Collapsed"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PartyMediaApp" Style="{StaticResource Caption}" Text="Tocando agora"/>
                                <TextBlock x:Name="PartyMediaTitle" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock x:Name="PartyMediaArtist" FontSize="14" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel x:Name="PartyMediaButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PartyPrevious" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Voltar (vale para todo mundo)" Click="MediaPrevious_Click"/>
                                <Button x:Name="PartyPlayPause" Style="{StaticResource PrimaryButton}" Width="52" Height="44" Padding="0" Margin="10,0"
                                        HorizontalContentAlignment="Center" ToolTip="Pausar (vale para todo mundo)" Click="MediaPlayPause_Click">
                                    <TextBlock x:Name="PartyPlayGlyph" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="16"/>
                                </Button>
                                <Button x:Name="PartyNext" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Pular (vale para todo mundo)" Click="MediaNext_Click"/>
                            </StackPanel>
                            <Grid x:Name="PartySeekRow" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PartyBack" Style="{StaticResource SkipButton}" Content="−10" ToolTip="Voltar 10 segundos (vale para todo mundo)"
                                        AutomationProperties.Name="Voltar 10 segundos" Click="SeekBack_Click" Margin="0,0,6,0"/>
                                <TextBlock x:Name="PartyPosition" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="48" Text="0:00"/>
                                <Slider x:Name="PartySeek" Grid.Column="2" Margin="10,0" Minimum="0" Maximum="1" ToolTip="Arraste para ir a outro ponto (vale para todo mundo)"
                                        AutomationProperties.Name="Ponto da música ou do vídeo" IsMoveToPointEnabled="True" SmallChange="5" LargeChange="10"
                                        PreviewMouseLeftButtonDown="Seek_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Seek_PreviewMouseLeftButtonUp"
                                        PreviewKeyUp="Seek_PreviewKeyUp" ValueChanged="Seek_ValueChanged"/>
                                <TextBlock x:Name="PartyDuration" Grid.Column="3" Style="{StaticResource Caption}" VerticalAlignment="Center" Width="48"
                                           TextAlignment="Right" Text="0:00"/>
                                <Button x:Name="PartyForward" Grid.Column="4" Style="{StaticResource SkipButton}" Content="+10" ToolTip="Avançar 10 segundos (vale para todo mundo)"
                                        AutomationProperties.Name="Avançar 10 segundos" Click="SeekForward_Click" Margin="6,0,0,0"/>
                            </Grid>
                            <!-- Estado da minutagem (1.4.0): ao vivo, indo para um ponto, pronto, recusado ou por que não dá para buscar -->
                            <TextBlock x:Name="PartySeekNote" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                        </Grid>
                    </Border>
                    </Grid>
                </StackPanel>
                <controls:SpectrumVisualizer x:Name="PartySpectrum" Grid.Row="1" MaxHeight="380" Margin="0,36,0,0" BarGap="6" Mirror="True"/>
                <UniformGrid Grid.Row="2" Columns="4" Margin="0,28,-14,0" HorizontalAlignment="Left" MaxWidth="760">
                    <Border Style="{StaticResource InsetCard}" Margin="0,0,14,0" Padding="16,12" Background="#B3101932">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Qualidade"/>
                            <TextBlock x:Name="PartyQuality" Style="{StaticResource Stat}" FontSize="20" Text="—" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InsetCard}" Margin="0,0,14,0" Padding="16,12" Background="#B3101932">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Atraso do som"/>
                            <TextBlock x:Name="PartyBuffer" Style="{StaticResource Stat}" FontSize="20" Text="—" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InsetCard}" Margin="0,0,14,0" Padding="16,12" Background="#B3101932">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Ping"/>
                            <TextBlock x:Name="PartyPing" Style="{StaticResource Stat}" FontSize="20" Text="—" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InsetCard}" Margin="0,0,14,0" Padding="16,12" Background="#B3101932">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Pacotes salvos"/>
                            <TextBlock x:Name="PartyRecovered" Style="{StaticResource Stat}" FontSize="20" Text="—" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>

        <!-- Câmera que vai junto com a tela: quadrinho num canto. Com o vídeo na GPU, vai para uma janela sobreposta. -->
        <Border x:Name="CameraPip" Width="320" Height="180" CornerRadius="16" BorderThickness="1" BorderBrush="#4DFFFFFF" Background="#FF0B1224"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0" Visibility="Collapsed" Cursor="Hand"
                ToolTip="Câmera de quem está transmitindo. Clique para mudar de canto; C esconde e mostra."
                MouseLeftButtonUp="CameraPip_MouseLeftButtonUp">
            <Grid>
                <Border CornerRadius="15">
                    <Border.Background>
                        <ImageBrush x:Name="CameraBrush" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" CornerRadius="9" Padding="8,3" Background="#B30B1224">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Pink}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CameraLabel" FontSize="11.5" FontWeight="SemiBold" Text="Câmera" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Estados: conectando, aguardando aprovação, reconectando, erro -->
        <Border x:Name="StateOverlay" Background="#F20B1224" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="22" Padding="40,34"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Margin="24">
            <StackPanel>
                <Border x:Name="StateTile" Width="68" Height="68" CornerRadius="20" HorizontalAlignment="Center" BorderThickness="1"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}">
                    <TextBlock x:Name="StateIcon" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE71B;"/>
                </Border>
                <TextBlock x:Name="StateTitle" FontFamily="{DynamicResource FontDisplay}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,20,0,8" Text="Conectando…"/>
                <TextBlock x:Name="StateMessage" FontSize="14.5" Foreground="{DynamicResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"/>
                <ProgressBar x:Name="StateProgress" IsIndeterminate="True" Height="4" Margin="40,22,40,0"/>
                <StackPanel x:Name="StateButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed">
                    <Button Style="{StaticResource PrimaryButton}" Content="Fechar o player" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Estatísticas (F3). Com o vídeo na GPU, vai para uma janela sobreposta. -->
        <Border x:Name="StatsPanel" Background="#E60B1224" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,12"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="ESTATÍSTICAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentText}" Margin="0,0,0,8"/>
                <TextBlock x:Name="StatsText" FontFamily="{DynamicResource FontMono}" FontSize="12" LineHeight="18" Foreground="#E6ECFF"/>
            </StackPanel>
        </Border>

        <!-- Barra de controles: some sozinha com o mouse parado. Com o vídeo na GPU, vai para uma janela sobreposta.
             Cada parte tem tamanho fixo (1.3.0): o nome da música, a qualidade e o nome de quem transmite são cortados com
             reticências e a barra só muda de tamanho quando a janela muda (o nome da música usa o espaço que sobra). -->
        <Border x:Name="ControlBar" Background="#F00B1224" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="18" Padding="10,8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26">
            <StackPanel>
            <!-- Minutagem do vídeo que está tocando no PC de quem transmite (1.4.0): altura fixa e a mesma largura da barra.
                 Arrastar só mexe na prévia; o ponto vai para o host ao soltar, e todo mundo vê o vídeo no ponto novo. -->
            <Grid x:Name="BarTimeline" Height="30" Margin="2,0,2,4" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BarBack" Style="{StaticResource SkipButton}" Height="30" MinHeight="30" Content="−10" ToolTip="Voltar 10 segundos (←, vale para todo mundo)"
                        AutomationProperties.Name="Voltar 10 segundos" Click="SeekBack_Click"/>
                <TextBlock x:Name="BarPosition" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           Width="52" TextAlignment="Right" Text="0:00"/>
                <Slider x:Name="BarSeek" Grid.Column="2" Margin="10,0" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                        SmallChange="5" LargeChange="10" ToolTip="Arraste para ir a outro ponto (vale para todo mundo)" AutomationProperties.Name="Ponto do vídeo"
                        PreviewMouseLeftButtonDown="Seek_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Seek_PreviewMouseLeftButtonUp"
                        PreviewKeyUp="Seek_PreviewKeyUp" ValueChanged="Seek_ValueChanged"/>
                <TextBlock x:Name="BarSeekNote" Grid.Column="2" Margin="10,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                <TextBlock x:Name="BarDuration" Grid.Column="3" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                           Width="52" Text="0:00"/>
                <TextBlock x:Name="BarSeekStatus" Grid.Column="4" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Width="92"
                           Foreground="{DynamicResource AccentText}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="BarForward" Grid.Column="5" Style="{StaticResource SkipButton}" Height="30" MinHeight="30" Content="+10" ToolTip="Avançar 10 segundos (→, vale para todo mundo)"
                        AutomationProperties.Name="Avançar 10 segundos" Click="SeekForward_Click"/>
            </Grid>
            <StackPanel x:Name="BarContent" Orientation="Horizontal" Height="40">
                <Border Style="{StaticResource Pill}" Background="{DynamicResource PinkSoft}" BorderBrush="{DynamicResource PinkSoft}" TextElement.Foreground="{DynamicResource Pink}"
                        Margin="4,0,10,0" MaxWidth="190">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Pink}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BarTitle" Text="Ao vivo" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <!-- Música ou vídeo tocando no PC de quem transmite (1.2.0): voltar, pausar e pular para todo mundo -->
                <StackPanel x:Name="BarMedia" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="BarPrevious" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Voltar (vale para todo mundo)" Click="MediaPrevious_Click"/>
                    <Button x:Name="BarPlayPause" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="Pausar (vale para todo mundo)" Click="MediaPlayPause_Click"/>
                    <Button x:Name="BarNext" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Pular (vale para todo mundo)" Click="MediaNext_Click"/>
                    <StackPanel x:Name="BarMediaInfo" VerticalAlignment="Center" Margin="8,0,6,0" Width="0" Visibility="Collapsed">
                        <TextBlock x:Name="BarMediaTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BarMediaArtist" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Width="1" Height="22" Background="#26FFFFFF" Margin="6,0,8,0"/>
                </StackPanel>
                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Mudo (M)" Click="Mute_Click"/>
                <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="6,0,10,0" ValueChanged="Volume_Changed"/>
                <Border Width="1" Height="22" Background="#26FFFFFF" Margin="4,0,8,0"/>
                <!-- Controles de quem assiste (1.2.0): só aparecem com um host que deixa -->
                <Button x:Name="QualityButton" Style="{StaticResource ChipButton}" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" Width="150"
                        HorizontalContentAlignment="Left" Click="Quality_Click" ToolTip="Trocar a qualidade da transmissão (vale para todo mundo)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="13" Margin="0,0,7,0"/>
                        <TextBlock x:Name="QualityText" Text="Qualidade" TextTrimming="CharacterEllipsis" MaxWidth="104"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AppsButton" Style="{StaticResource IconButton}" Content="&#xE71D;" ToolTip="Tirar apps do som da transmissão" Click="Apps_Click"
                        Margin="0,0,4,0" Visibility="Collapsed"/>
                <Popup x:Name="RemoteQualityPopup" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="RemotePopup_Closed">
                    <Border Style="{StaticResource PlayerPopupCard}">
                        <StackPanel>
                            <TextBlock Text="Qualidade da transmissão" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,14"
                                       Text="Muda para todo mundo que está assistindo. Na qualidade automática, ela ainda baixa sozinha quando a rede aperta."/>
                            <StackPanel x:Name="ScreenQualityPanel">
                                <TextBlock Style="{StaticResource Label}" Text="Resolução"/>
                                <WrapPanel x:Name="ResolutionChoices" Margin="0,6,0,8"/>
                                <TextBlock Style="{StaticResource Label}" Text="FPS"/>
                                <WrapPanel x:Name="FpsChoices" Margin="0,6,0,8"/>
                            </StackPanel>
                            <StackPanel x:Name="CameraQualityPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Label}" Text="Câmera"/>
                                <WrapPanel x:Name="CameraChoices" Margin="0,6,0,8"/>
                            </StackPanel>
                            <CheckBox x:Name="FixedQualityChoice" Style="{StaticResource Switch}" Content="Qualidade fixa (não baixa sozinha)" Margin="0,2,0,0"/>
                            <DockPanel Margin="0,14,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Aplicar" MinHeight="34" Padding="18,0" Click="ApplyQuality_Click"/>
                                <TextBlock x:Name="QualityNote" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup x:Name="RemoteAppsPopup" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="RemotePopup_Closed">
                    <Border Style="{StaticResource PlayerPopupCard}">
                        <StackPanel>
                            <TextBlock Text="Tirar apps do som" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                                       Text="Marque o que ninguém deve ouvir. Muda o som para todo mundo que está assistindo."/>
                            <TextBlock x:Name="AppsEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,6" Visibility="Collapsed"
                                       Text="Nenhum app com som no PC de quem transmite agora."/>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AppsChoices"/>
                            </ScrollViewer>
                            <DockPanel Margin="0,14,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Aplicar" MinHeight="34" Padding="18,0" Click="ApplyApps_Click"/>
                                <TextBlock x:Name="AppsNote" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="CameraButton" Style="{StaticResource IconButton}" Content="&#xE8B8;" ToolTip="Mostrar ou esconder a câmera (C)" Click="Camera_Click"
                        Margin="0,0,4,0" Visibility="Collapsed"/>
                <Button x:Name="StatsButton" Style="{StaticResource IconButton}" Content="&#xE9D9;" ToolTip="Estatísticas (F3)" Click="Stats_Click"/>
                <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Tela cheia (F ou duplo clique)" Click="Fullscreen_Click" Margin="4,0,0,0"/>
                <Border Width="1" Height="22" Background="#26FFFFFF" Margin="8,0,8,0"/>
                <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource Danger}" Content="&#xE711;" ToolTip="Sair da transmissão" Click="Close_Click"/>
            </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
