<Window x:Class="ScreenFlow.App.Windows.ChatImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imagem do chat" Width="1200" Height="800" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Icon="/Assets/screenflow.ico"
        Background="{DynamicResource VideoBackground}" Foreground="{DynamicResource VideoText}"
        FontFamily="{DynamicResource FontUi}" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ViewerArrowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="Background" Value="#B30B1224"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E31D2945"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource VideoBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="88"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Imagem do chat" Style="{StaticResource Heading}" FontSize="17"/>
                    <TextBlock x:Name="PositionText" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButton}"
                        Content="&#xE711;" ToolTip="Fechar (Esc)" Click="Close_Click"/>
            </Grid>
        </Border>

        <Grid x:Name="ImageViewport" Grid.Row="1" ClipToBounds="True" Background="{DynamicResource VideoBackground}"
              PreviewMouseWheel="Viewport_PreviewMouseWheel" PreviewMouseMove="Viewport_PreviewMouseMove"
              PreviewMouseLeftButtonUp="Viewport_PreviewMouseLeftButtonUp">
            <Image x:Name="ImagePreview" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                   PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown"/>

            <Border x:Name="UnavailablePanel" Background="#CC0B1224" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Imagem indisponível" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ela pode ter sido removida do histórico guardado." Style="{StaticResource Caption}"
                               Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="PreviousButton" Style="{StaticResource ViewerArrowButton}" Content="‹" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="18,0" ToolTip="Imagem anterior (←)" Click="Previous_Click"/>
            <Button x:Name="NextButton" Style="{StaticResource ViewerArrowButton}" Content="›" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="18,0" ToolTip="Próxima imagem (→)" Click="Next_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="AuthorText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CaptionText" Style="{StaticResource Caption}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ActionStatusText" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ViewerToolButton}" Content="−" FontSize="20" ToolTip="Diminuir zoom"
                            Click="ZoomOut_Click"/>
                    <TextBlock x:Name="ZoomText" Width="48" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ViewerToolButton}" Content="+" FontSize="18" ToolTip="Aumentar zoom"
                            Click="ZoomIn_Click"/>
                    <Button Style="{StaticResource ViewerToolButton}" Content="Ajustar" ToolTip="Ajustar à janela"
                            Click="ZoomFit_Click"/>
                    <Button Style="{StaticResource ViewerToolButton}" Content="Copiar" ToolTip="Copiar imagem (Ctrl+C)"
                            Click="Copy_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Salvar" MinHeight="36" Height="36" Padding="16,0"
                            ToolTip="Salvar imagem (Ctrl+S)" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
