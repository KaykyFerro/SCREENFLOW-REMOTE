<!-- Tema claro: as mesmas cores vivas, com tons mais fortes para contraste no fundo claro.
     O fundo é um cinza azulado e as bordas são marcadas, para os cartões brancos se separarem bem. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#E8EDF5</Color>
    <Color x:Key="MintColor">#12C98A</Color>
    <Color x:Key="CyanColor">#0BB4D4</Color>
    <Color x:Key="VioletColor">#6E4DFF</Color>
    <Color x:Key="PinkColor">#F0337A</Color>
    <Color x:Key="AmberColor">#E59410</Color>

    <SolidColorBrush x:Key="Background" Color="#E8EDF5"/>
    <SolidColorBrush x:Key="Sidebar" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#F0F3F9"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#E3E9F4"/>
    <SolidColorBrush x:Key="SurfaceSunken" Color="#E6EBF4"/>
    <SolidColorBrush x:Key="Border" Color="#CDD6E5"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#AFBBD2"/>
    <SolidColorBrush x:Key="Divider" Color="#DCE2ED"/>

    <SolidColorBrush x:Key="Text" Color="#0D1426"/>
    <SolidColorBrush x:Key="TextMuted" Color="#435069"/>
    <SolidColorBrush x:Key="TextSubtle" Color="#6F7B96"/>

    <SolidColorBrush x:Key="Accent" Color="#1FD99A"/>
    <SolidColorBrush x:Key="AccentHover" Color="#3BE3AA"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#14BF86"/>
    <SolidColorBrush x:Key="AccentText" Color="#0B9A6B"/>
    <SolidColorBrush x:Key="OnAccent" Color="#03231A"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2612C98A"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#8012C98A"/>
    <SolidColorBrush x:Key="Cyan" Color="#0BA5C4"/>
    <SolidColorBrush x:Key="CyanSoft" Color="#260BB4D4"/>
    <SolidColorBrush x:Key="Violet" Color="#6E4DFF"/>
    <SolidColorBrush x:Key="VioletSoft" Color="#266E4DFF"/>
    <SolidColorBrush x:Key="Pink" Color="#E62E73"/>
    <SolidColorBrush x:Key="PinkSoft" Color="#26F0337A"/>
    <SolidColorBrush x:Key="Amber" Color="#C77A00"/>
    <SolidColorBrush x:Key="AmberSoft" Color="#24E59410"/>
    <SolidColorBrush x:Key="Blue" Color="#2F6FEB"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#1F2F6FEB"/>

    <SolidColorBrush x:Key="Success" Color="#0FA872"/>
    <SolidColorBrush x:Key="Warning" Color="#D98A00"/>
    <SolidColorBrush x:Key="Danger" Color="#E03A58"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#1FE03A58"/>
    <SolidColorBrush x:Key="Live" Color="#F0337A"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EE6A6" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#55EDB8" Offset="0"/>
        <GradientStop Color="#4ADCF1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#12C98A" Offset="0"/>
        <GradientStop Color="#0BB4D4" Offset="0.5"/>
        <GradientStop Color="#6E4DFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartyGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6E4DFF" Offset="0"/>
        <GradientStop Color="#F0337A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CameraGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0BB4D4" Offset="0"/>
        <GradientStop Color="#2F6FEB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiveGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F0337A" Offset="0"/>
        <GradientStop Color="#FF6A3D" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="PageGlow" Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.6" RadiusY="0.55">
        <GradientStop Color="#2612C98A" Offset="0"/>
        <GradientStop Color="#100BB4D4" Offset="0.5"/>
        <GradientStop Color="#00E8EDF5" Offset="1"/>
    </RadialGradientBrush>
    <!-- O cartão com a aurora continua escuro no tema claro. -->
    <LinearGradientBrush x:Key="HeroScrim" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F2091127" Offset="0"/>
        <GradientStop Color="#B3091127" Offset="0.45"/>
        <GradientStop Color="#1A091127" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Overlay" Color="#99E8EDF5"/>
    <SolidColorBrush x:Key="Shadow" Color="#5B6B8C"/>
    <SolidColorBrush x:Key="VideoBackground" Color="#000000"/>
    <SolidColorBrush x:Key="VideoOverlay" Color="#D90B1224"/>
    <SolidColorBrush x:Key="VideoText" Color="#FFFFFF"/>
</ResourceDictionary>
