<!-- Tokens de cor do tema claro. Todas as telas usam só estas chaves (via DynamicResource). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#3D6FF5</Color>
    <Color x:Key="BackgroundColor">#F5F7FA</Color>
    <SolidColorBrush x:Key="Accent" Color="#3D6FF5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2F5DE0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E3EAFE"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Background" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Border" Color="#DDE2EA"/>
    <SolidColorBrush x:Key="Text" Color="#141A24"/>
    <SolidColorBrush x:Key="TextMuted" Color="#556070"/>
    <SolidColorBrush x:Key="TextSubtle" Color="#8A94A4"/>
    <SolidColorBrush x:Key="Success" Color="#1E8E55"/>
    <SolidColorBrush x:Key="Warning" Color="#B7791F"/>
    <SolidColorBrush x:Key="Danger" Color="#D13A48"/>
    <SolidColorBrush x:Key="Overlay" Color="#E6F5F7FA"/>
    <!-- Fundo da área de vídeo do player (sempre preto, nos dois temas) -->
    <SolidColorBrush x:Key="VideoBackground" Color="#000000"/>
    <SolidColorBrush x:Key="VideoOverlay" Color="#B3000000"/>
    <SolidColorBrush x:Key="VideoText" Color="#FFFFFF"/>
</ResourceDictionary>
