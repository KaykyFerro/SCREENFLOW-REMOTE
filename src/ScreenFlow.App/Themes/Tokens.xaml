<!-- Tokens que não dependem do tema: tipografia, espaçamento e raios. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Inter quando instalada; senão a fonte do sistema. -->
    <FontFamily x:Key="FontUi">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Inter, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeHeading">20</sys:Double>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">40</sys:Double>

    <!-- Escala de espaçamento de 4 px -->
    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">16</Thickness>
    <Thickness x:Key="SpaceLg">24</Thickness>
    <Thickness x:Key="SpaceXl">32</Thickness>
    <Thickness x:Key="StackGap">0,0,0,16</Thickness>
    <Thickness x:Key="FieldGap">0,0,0,12</Thickness>
    <Thickness x:Key="LabelGap">0,0,0,6</Thickness>
    <Thickness x:Key="ControlPadding">12,9</Thickness>
    <Thickness x:Key="CardPadding">24</Thickness>

    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <sys:Double x:Key="ControlHeight">40</sys:Double>
    <sys:Double x:Key="ContentMaxWidth">1180</sys:Double>
</ResourceDictionary>
