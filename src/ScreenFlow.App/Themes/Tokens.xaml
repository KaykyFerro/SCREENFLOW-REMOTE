<!-- Tokens que não dependem do tema: tipografia, espaçamento, raios e animação.
     As fontes Inter embutidas (Assets/Fonts) são registradas no início do app (ThemeManager.RegisterFonts);
     aqui ficam só as alternativas do sistema. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">15</sys:Double>
    <sys:Double x:Key="FontSizeHeading">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeHero">30</sys:Double>
    <sys:Double x:Key="FontSizePage">34</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">40</sys:Double>

    <!-- Escala de espaçamento de 4 px -->
    <Thickness x:Key="StackGap">0,0,0,20</Thickness>
    <Thickness x:Key="FieldGap">0,0,0,14</Thickness>
    <Thickness x:Key="LabelGap">0,0,0,7</Thickness>
    <Thickness x:Key="ControlPadding">14,0</Thickness>
    <Thickness x:Key="CardPadding">24</Thickness>
    <Thickness x:Key="PagePadding">40,8,40,40</Thickness>

    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <sys:Double x:Key="ControlHeight">42</sys:Double>
    <sys:Double x:Key="ContentMaxWidth">1240</sys:Double>
    <Duration x:Key="FastDuration">0:0:0.12</Duration>
    <Duration x:Key="MediumDuration">0:0:0.22</Duration>
</ResourceDictionary>
