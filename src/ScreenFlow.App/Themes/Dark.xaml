<!-- Tokens de cor do tema escuro. Todas as telas usam só estas chaves (via DynamicResource). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#5B8CFF</Color>
    <Color x:Key="BackgroundColor">#0D1117</Color>
    <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#7AA2FF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1F2A44"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Background" Color="#0D1117"/>
    <SolidColorBrush x:Key="Surface" Color="#151A22"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1C222C"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#242B37"/>
    <SolidColorBrush x:Key="Border" Color="#2B3341"/>
    <SolidColorBrush x:Key="Text" Color="#E8ECF3"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A3ADBD"/>
    <SolidColorBrush x:Key="TextSubtle" Color="#6B7586"/>
    <SolidColorBrush x:Key="Success" Color="#3FB97A"/>
    <SolidColorBrush x:Key="Warning" Color="#E0A43A"/>
    <SolidColorBrush x:Key="Danger" Color="#F0616D"/>
    <SolidColorBrush x:Key="Overlay" Color="#CC0D1117"/>
    <!-- Fundo da área de vídeo do player (sempre preto, nos dois temas) -->
    <SolidColorBrush x:Key="VideoBackground" Color="#000000"/>
    <SolidColorBrush x:Key="VideoOverlay" Color="#B3000000"/>
    <SolidColorBrush x:Key="VideoText" Color="#FFFFFF"/>
</ResourceDictionary>
