<!-- Tema escuro: azul-marinho profundo com menta, ciano, violeta e rosa vivos.
     Todas as telas usam só estas chaves (via DynamicResource), então o tema troca em tempo real. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#090E1C</Color>
    <Color x:Key="MintColor">#2EE6A6</Color>
    <Color x:Key="CyanColor">#22D3EE</Color>
    <Color x:Key="VioletColor">#8B6CFF</Color>
    <Color x:Key="PinkColor">#FF4D8D</Color>
    <Color x:Key="AmberColor">#FFB547</Color>

    <!-- Superfícies -->
    <SolidColorBrush x:Key="Background" Color="#090E1C"/>
    <SolidColorBrush x:Key="Sidebar" Color="#0B1224"/>
    <SolidColorBrush x:Key="Surface" Color="#101932"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#16213F"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#1C2A4E"/>
    <SolidColorBrush x:Key="SurfaceSunken" Color="#0A1128"/>
    <SolidColorBrush x:Key="Border" Color="#1D2948"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#2B3B66"/>
    <SolidColorBrush x:Key="Divider" Color="#17213C"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="Text" Color="#F2F6FF"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A9B4CF"/>
    <SolidColorBrush x:Key="TextSubtle" Color="#6E7A9A"/>

    <!-- Destaques -->
    <SolidColorBrush x:Key="Accent" Color="#2EE6A6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#5BF0BE"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#20C98F"/>
    <SolidColorBrush x:Key="AccentText" Color="#3DF0B0"/>
    <SolidColorBrush x:Key="OnAccent" Color="#03231A"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1F2EE6A6"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#662EE6A6"/>
    <SolidColorBrush x:Key="Cyan" Color="#22D3EE"/>
    <SolidColorBrush x:Key="CyanSoft" Color="#2222D3EE"/>
    <SolidColorBrush x:Key="Violet" Color="#9D84FF"/>
    <SolidColorBrush x:Key="VioletSoft" Color="#2A8B6CFF"/>
    <SolidColorBrush x:Key="Pink" Color="#FF5C97"/>
    <SolidColorBrush x:Key="PinkSoft" Color="#26FF4D8D"/>
    <SolidColorBrush x:Key="Amber" Color="#FFC266"/>
    <SolidColorBrush x:Key="AmberSoft" Color="#24FFB547"/>
    <SolidColorBrush x:Key="Blue" Color="#5B9BFF"/>
    <SolidColorBrush x:Key="BlueSoft" Color="#245B9BFF"/>

    <!-- Estados -->
    <SolidColorBrush x:Key="Success" Color="#2EE6A6"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB547"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5C7A"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#24FF5C7A"/>
    <SolidColorBrush x:Key="Live" Color="#FF4D8D"/>

    <!-- Degradês -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DF5B4" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6CF8C8" Offset="0"/>
        <GradientStop Color="#4FDEF3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#2EE6A6" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="0.5"/>
        <GradientStop Color="#8B6CFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PartyGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B6CFF" Offset="0"/>
        <GradientStop Color="#FF4D8D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CameraGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#5B9BFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiveGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF4D8D" Offset="0"/>
        <GradientStop Color="#FF7A59" Offset="1"/>
    </LinearGradientBrush>
    <!-- Brilho sutil no topo da área de conteúdo -->
    <RadialGradientBrush x:Key="PageGlow" Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.6" RadiusY="0.55">
        <GradientStop Color="#1A2EE6A6" Offset="0"/>
        <GradientStop Color="#0A22D3EE" Offset="0.5"/>
        <GradientStop Color="#00090E1C" Offset="1"/>
    </RadialGradientBrush>
    <!-- Véu sobre a aurora para o texto do cartão principal ficar legível -->
    <LinearGradientBrush x:Key="HeroScrim" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F2091127" Offset="0"/>
        <GradientStop Color="#B3091127" Offset="0.45"/>
        <GradientStop Color="#1A091127" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Overlay" Color="#B3050914"/>
    <SolidColorBrush x:Key="Shadow" Color="#000000"/>
    <!-- Área de vídeo do player (sempre escura, nos dois temas) -->
    <SolidColorBrush x:Key="VideoBackground" Color="#000000"/>
    <SolidColorBrush x:Key="VideoOverlay" Color="#D90B1224"/>
    <SolidColorBrush x:Key="VideoText" Color="#FFFFFF"/>
</ResourceDictionary>
